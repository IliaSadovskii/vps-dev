# Управляется Ansible: roles/paseo/templates/paseo.service.j2
[Unit]
Description=Paseo — веб/мобильный клиент к CLI агентов
After=network-online.target

[Service]
Type=simple
# Тот же пользователь, что логинится в CLI агентов (roles/agents): paseo
# находит claude/codex/opencode на его $PATH и их логин, без своей копии.
User={{ base_deploy_user }}
WorkingDirectory={{ base_projects_dir }}
# Только loopback: в частную сеть отдаёт ports-web через общий прокси, как
# и остальные службы машины (см. roles/aoe).
#
# Пароля нет — границу держит Tailscale, как у Dozzle, DbGate и aoe.
# --hostnames — защита от DNS rebinding: без имени машины в tailnet демон
# отверг бы запрос через прокси по чужому для него заголовку Host.
#
{% if paseo_version is version('0.9.0', '>=') %}
# С 0.9 флаги запуска убраны: `paseo start` берёт всё из config.json и
# уходит в фон, а переопределения для развёртывания — только окружением
# у `paseo daemon run`, который держит демона на переднем плане (для
# systemd Type=simple это обязательно, как раньше --foreground). Окружение,
# а не config.json: тот правит и сам пользователь из веб-клиента.
Environment=PASEO_LISTEN=127.0.0.1:{{ paseo_port }}
Environment=PASEO_WEB_UI_ENABLED=true
Environment=PASEO_RELAY_ENABLED=false
{% if paseo_tailnet_host | default('') | length > 0 %}
Environment=PASEO_HOSTNAMES={{ paseo_tailnet_host }}
{% endif %}
ExecStart=/usr/bin/paseo daemon run --home {{ paseo_home }}
{% else %}
# --foreground обязателен: без него `paseo start` форкает воркера в фон
# и сам выходит с кодом 0 — systemd (Type=simple) читает это как «служба
# остановилась» и убивает всю cgroup вместе с только что запущенным
# воркером (проверено: без флага служба висела «inactive (dead)», а
# демон оставался жить осиротевшим считанные секунды до убийства).
ExecStart=/usr/bin/paseo start --listen 127.0.0.1:{{ paseo_port }} --home {{ paseo_home }} --web-ui --no-relay --foreground{% if paseo_tailnet_host | default('') | length > 0 %} --hostnames {{ paseo_tailnet_host }}{% endif %}

{% endif %}

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
