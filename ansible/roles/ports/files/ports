#!/usr/bin/env bash
# ports — единый учёт портов проектов на этом VPS.
#
# Исходник — bin/ports в репозитории vps; в ~/.local/bin ставит setup-dev.sh.
# Реестр руками не правь: пользуйся `ports claim`.
#
# МОДЕЛЬ. Каждому проекту — блок из 10 портов (80X0..80X9). Реестр — файлы
# ports/<имя>.env в репозитории (в git, чтобы пережить переезд). Источник правды
# о занятости — реестр ПЛЮС реально слушающие порты: так застолбим и то, что
# кто-то поднял мимо реестра, и новый проект на это не наткнётся.
#
# Здесь речь только про host-порты 80xx, которые docker публикует на 127.0.0.1.
# В tailnet эти же веб-сервисы выводит ports-web на том же номере порта (и рисует
# дашборд :8062) — отдельного диапазона для tailnet больше нет.
#
# Диапазон 90xx не раздаётся и в реестр не попадает: это ЗЕРКАЛО 80xx под общий
# прокси vps-proxy (порт 80XY → теневой 90XY), его целиком держит ports-web.
set -uo pipefail

PORTS_DIR="${PORTS_DIR:-/var/lib/vps-dev/ports}"

# Диапазон раздачи и заповедники.
LO=8010                            # ниже не раздаём: 8000-8009 оставлено под ручное/системное
HI=8990                            # верхняя база блока (последний блок 8990-8999)
# Два десятка, а не один: первый занят целиком (Dozzle … почта), и службе,
# которую добавили после, места в нём уже не нашлось.
RESERVED_BASES=(8060 8070)         # 8060-8079 — инфра-сервисы (dozzle, dbgate, …)
RESERVED_NOTE="8060-8079 — инфра: Dozzle 8060, DbGate 8061, дашборд 8062, VS Code 8063, aoe 8065, терминал 8066, файлы 8067, мониторинг 8068, почта 8069, лимиты 8070, общий промпт 8071, обновления 8072"
TAILNET_NOTE="в tailnet веб-сервисы отдаются на ТОМ ЖЕ номере порта (ports-web, через прокси на теневом 9XYZ); дашборд со ссылками — :8062"

c_r=$'\e[31m'; c_g=$'\e[32m'; c_y=$'\e[33m'; c_c=$'\e[36m'; c_d=$'\e[2m'; c_0=$'\e[0m'
die(){ echo "${c_r}✗ $*${c_0}" >&2; exit 1; }

mkdir -p "$PORTS_DIR"

# ---------------------------------------------------------------- утилиты ----

# Строки «ИМЯ=порт» из файла реестра, без хвостовых комментариев. Комментарий
# после номера — штатный: его показывает дашборд как название карточки. Раньше
# такие строки не проходили grep и порт не считался занятым нигде, кроме
# BASE_PORT (найдено при разборе схемы стендов задач).
port_lines(){
  sed -nE 's/^[[:space:]]*([A-Za-z0-9_]+)=([0-9]+).*$/\1=\2/p' "$1"
}

# минимальный порт в файле реестра → база его десятка (или пусто)
file_base(){
  local min
  min="$(port_lines "$1" 2>/dev/null | cut -d= -f2 | sort -n | head -1)"
  [[ -n "$min" ]] && echo "$(( min / 10 * 10 ))"
}

# "<база> <имя>" для каждого файла реестра
registry_bases(){
  shopt -s nullglob
  local f b
  for f in "$PORTS_DIR"/*.env; do
    b="$(file_base "$f")"; [[ -n "$b" ]] && echo "$b $(basename "$f" .env)"
  done
  shopt -u nullglob
}

# реально слушающие порты в 8000-8999 (весь диапазон раздачи LO..HI, только docker
# на 127.0.0.1). Слушателей
# tailscaled на tailnet-адресе (это наши же serve-порты) не считаем — иначе
# опубликованный в tailnet сервис задвоил бы свой же порт как «занятый».
live_ports(){ ss -ltnH 2>/dev/null | grep -oE '127\.0\.0\.1:8[0-9][0-9][0-9]\b' | grep -oE '8[0-9][0-9][0-9]' | sort -un; }
live_bases(){ live_ports | awk '{print int($1/10)*10}' | sort -un; }

is_reserved(){ local b=$1 r; for r in "${RESERVED_BASES[@]}"; do [[ "$b" == "$r" ]] && return 0; done; return 1; }

# ---------------------------------------------------------------- команды ----

# Имена переменных портов из docker-compose.yml: строки `${APP_PORT:-8090}`
# и `${APP_PORT:?…}` внутри ports:. Порт, зашитый числом, переменной не
# имеет — про такие говорим отдельно, подставить в них нечего.
compose_vars(){
  local file="${1:-docker-compose.yml}"
  [[ -f "$file" ]] || return 1
  awk '
    /^[[:space:]]*ports:[[:space:]]*$/ { inports=1; next }
    inports && /^[[:space:]]*-/ { print; next }
    inports && /^[[:space:]]*[a-zA-Z_]+:/ { inports=0 }
  ' "$file" | grep -oE '\$\{[A-Za-z_][A-Za-z0-9_]*' | sed 's/^\${//' | awk '!seen[$0]++'
}

# Сколько портов, зашитых числом, в ports: — про них предупреждаем.
compose_hardcoded(){
  local file="${1:-docker-compose.yml}"
  [[ -f "$file" ]] || return 0
  awk '
    /^[[:space:]]*ports:[[:space:]]*$/ { inports=1; next }
    inports && /^[[:space:]]*-/ { print; next }
    inports && /^[[:space:]]*[a-zA-Z_]+:/ { inports=0 }
  ' "$file" | grep -vE '\$\{' | grep -oE '[0-9]+:[0-9]+' | head -5
}

cmd_claim(){
  local like="" from_compose="" compose_file="docker-compose.yml"
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --like)          like="${2:-}"; shift 2 ;;
      --from-compose)  from_compose=1; shift
                       [[ "${1:-}" == *.y*ml ]] && { compose_file="$1"; shift; } ;;
      *) die "Неизвестный ключ '$1'. Смотри: ports --help" ;;
    esac
  done
  local name="${1:-}"; [[ -n "$name" ]] || die "Использование: ports claim [--like <проект>|--from-compose] <имя>"
  [[ "$name" =~ ^[A-Za-z0-9-]+$ ]] || die "Имя: только буквы, цифры и дефис."
  exec 9>"$PORTS_DIR/.lock"; flock 9    # атомарность: два проекта не займут один блок

  # Имена переменных выясняем до брони: если образца нет или compose не
  # читается, лучше не занять блок вовсе, чем занять пустым — такой блок
  # застолблён, но бесполезен, а повторный claim скажет «уже есть».
  local vars=()
  if [[ -n "$like" ]]; then
    local lf="$PORTS_DIR/$like.env"
    [[ -f "$lf" ]] || die "У образца '$like' нет блока (ports claim $like)."
    mapfile -t vars < <(port_lines "$lf" | cut -d= -f1 | grep -v '^BASE_PORT$')
    [[ ${#vars[@]} -gt 0 ]] || die "У образца '$like' в блоке нет ни одного порта — впиши их сначала ему."
  elif [[ -n "$from_compose" ]]; then
    [[ -f "$compose_file" ]] || die "Нет $compose_file в $(pwd) — нечего читать."
    mapfile -t vars < <(compose_vars "$compose_file")
    [[ ${#vars[@]} -gt 0 ]] || die "В $compose_file не нашлось портов вида \${APP_PORT:-8090}."
  fi
  if (( ${#vars[@]} > 10 )); then
    die "Нужно ${#vars[@]} портов, а блок — десять. Возьми второй блок отдельным именем ('$name-2') и раздели сервисы."
  fi

  local f="$PORTS_DIR/$name.env" base
  if [[ -f "$f" ]]; then
    base="$(file_base "$f")"; base="${base:-?}"
    # Блок уже есть, но пустой (так бывает после старого claim без имён) —
    # дописываем набор, раз его наконец знаем.
    local have; have="$(port_lines "$f" | cut -d= -f1 | grep -cvx 'BASE_PORT')"
    if (( ${#vars[@]} && have == 0 )); then
      local i=0 v
      for v in "${vars[@]}"; do echo "$v=$((base + i))" >> "$f"; i=$((i+1)); done
      echo "${c_g}✔ Блок ${base}-$((base+9)) был застолблён, но пуст — порты вписаны: $(printf '%s ' "${vars[@]}")${c_0}"
      return 0
    fi
    echo "${c_g}✔ У '$name' уже есть блок ${base}-$((base+9)).${c_0} Порты бери только из него."
    return 0
  fi

  # занятые базы = реестр ∪ живые ∪ заповедники
  declare -A busy; local b nm
  while read -r b nm; do [[ -n "$b" ]] && busy[$b]=1; done < <(registry_bases)
  while read -r b;    do [[ -n "$b" ]] && busy[$b]=1; done < <(live_bases)
  for b in "${RESERVED_BASES[@]}"; do busy[$b]=1; done

  base=""
  for (( b=LO; b<=HI; b+=10 )); do [[ -z "${busy[$b]:-}" ]] && { base=$b; break; }; done
  [[ -n "$base" ]] || die "Свободных блоков в ${LO}-$((HI+9)) не осталось."

  cat > "$f" <<EOF
# $name — блок ${base}-$((base+9)) (застолблено: ports claim)
# Все порты проекта берутся только из этого блока. Имена переменных диктует
# docker-compose проекта — допиши сюда нужные, напр. APP_PORT=${base}.
# Комментарий после порта станет названием карточки на дашборде:
#   APP_PORT=${base}   # Приложение
BASE_PORT=$base
EOF

  local v i=0
  for v in "${vars[@]}"; do
    echo "$v=$((base + i))" >> "$f"
    i=$((i+1))
  done

  echo "${c_g}✔ Проекту '$name' закреплён блок ${base}-$((base+9)).${c_0}"
  if (( ${#vars[@]} )); then
    echo "Порты записаны: $(printf '%s ' "${vars[@]}")— поднимай через ${c_c}ports run $name -- docker compose up -d${c_0}"
  else
    echo "Занимай порты ${base}..$((base+9)) — они гарантированно свободны и теперь видны как занятые."
  fi
  if [[ -n "$from_compose" ]]; then
    local hard; hard="$(compose_hardcoded "$compose_file")"
    [[ -z "$hard" ]] || echo "${c_y}⚠ В $compose_file есть порты числом: $(echo "$hard" | tr '\n' ' ')— их реестр не защищает, вынеси в переменные.${c_0}"
  fi
}

cmd_free(){
  local force=""
  [[ "${1:-}" == "--force" ]] && { force=1; shift; }
  local name="${1:-}"; [[ -n "$name" ]] || die "Использование: ports free [--force] <имя-проекта>"
  exec 9>"$PORTS_DIR/.lock"; flock 9
  local f="$PORTS_DIR/$name.env"
  [[ -f "$f" ]] || die "У '$name' нет закреплённого блока."
  local base; base="$(file_base "$f")"
  local lp; lp="$(live_ports | awk -v b="${base:-0}" '$1>=b && $1<=b+9' | tr '\n' ' ')"
  if [[ -n "$lp" ]]; then
    # Отдать блок, пока в нём слушают, — значит выдать эти же порты соседу и
    # получить «address already in use» у того, кто ни при чём.
    [[ -n "$force" ]] || die "В блоке ${base}-$((base+9)) ещё слушают: $lp. Останови проект ('ports run $name -- docker compose down -v') или настаивай: ports free --force $name"
    echo "${c_y}⚠ Блок отдан, хотя в нём слушают: $lp${c_0}"
  fi
  rm -f "$f"
  echo "${c_g}✔ Блок проекта '$name' освобождён (файл реестра удалён).${c_0}"
}

cmd_which(){
  local name="${1:-}"; [[ -n "$name" ]] || die "Использование: ports which <имя-проекта>"
  local f="$PORTS_DIR/$name.env"
  [[ -f "$f" ]] || die "У '$name' нет закреплённого блока (ports claim $name)."
  local base; base="$(file_base "$f")"
  echo "${base}-$((base+9))"
}

# Переменные блока для запуска: сами порты плюс COMPOSE_PROJECT_NAME —
# без него `docker compose` назовёт контейнеры по каталогу, и стенд задачи
# сцепится с основным (одни имена, одни тома).
cmd_env(){
  local name="${1:-}"; [[ -n "$name" ]] || die "Использование: ports env <имя>"
  local f="$PORTS_DIR/$name.env"
  [[ -f "$f" ]] || die "У '$name' нет блока (ports claim $name)."
  port_lines "$f"
  echo "COMPOSE_PROJECT_NAME=$name"
}

cmd_run(){
  local name="${1:-}"; [[ -n "$name" ]] || die "Использование: ports run <имя> -- <команда>"
  shift
  [[ "${1:-}" == "--" ]] && shift
  [[ $# -gt 0 ]] || die "Нечего запускать: ports run <имя> -- docker compose up -d"
  local line
  while read -r line; do export "${line?}"; done < <(cmd_env "$name")
  exec "$@"
}

cmd_doctor(){
  local problems=0

  # 1) один порт в реестре у двух проектов
  shopt -s nullglob; local files=( "$PORTS_DIR"/*.env ); shopt -u nullglob
  if (( ${#files[@]} )); then
    # `BASE_PORT` — метка начала блока, а не выданный порт: у большинства
    # проектов он совпадает с `APP_PORT`, и без этого исключения проверка
    # ругалась на каждый нормальный файл.
    local dups; dups="$(for f in "${files[@]}"; do
        port_lines "$f" | grep -v '^BASE_PORT=' | cut -d= -f2 | sort -u
      done | sort | uniq -d)"
    [[ -z "$dups" ]] || { echo "${c_r}✗ Порт выдан дважды в реестре: $(echo "$dups" | tr '\n' ' ')${c_0}"; problems=1; }
  fi

  # 2) живой порт 80xx, которого нет в реестре (сквоттер)
  declare -A reg; local b nm
  while read -r b nm; do [[ -n "$b" ]] && reg[$b]=1; done < <(registry_bases)
  while read -r b; do
    [[ -n "$b" ]] || continue
    is_reserved "$b" && continue
    [[ -n "${reg[$b]:-}" ]] && continue
    echo "${c_y}⚠ Блок ${b}-$((b+9)) слушается, но не в реестре — застолби: ports claim <имя>${c_0}"; problems=1
  done < <(live_bases)

  # 3) блок в реестре, но проект нигде не слушает (возможно, мусор)
  while read -r b nm; do
    [[ -n "$b" ]] || continue
    live_ports | awk -v b="$b" '$1>=b && $1<=b+9' | grep -q . && continue
    echo "${c_d}· ${b}-$((b+9)) ($nm): в реестре, но не запущен — норма, если проект просто выключен.${c_0}"
  done < <(registry_bases)

  (( problems )) || echo "${c_g}✔ Конфликтов нет: реестр и живые порты согласованы.${c_0}"
}

cmd_map(){
  echo "${c_c}Карта портов VPS${c_0} ${c_d}(host 80xx, все слушают только 127.0.0.1, наружу закрыты)${c_0}"
  echo "${c_d}Заповедник: ${RESERVED_NOTE}${c_0}"
  echo "${c_d}${TAILNET_NOTE}${c_0}"
  echo

  declare -A reg live; local b nm
  while read -r b nm; do [[ -n "$b" ]] && reg[$b]="$nm"; done < <(registry_bases)
  while read -r b;    do [[ -n "$b" ]] && live[$b]=1;    done < <(live_bases)

  printf "  ${c_d}%-11s %-14s %-10s %s${c_0}\n" "БЛОК" "ПРОЕКТ" "СТАТУС" "ЖИВЫЕ ПОРТЫ"
  local lp name status
  for (( b=LO; b<=HI; b+=10 )); do
    local proj="${reg[$b]:-}" resv=""; is_reserved "$b" && resv=1
    [[ -z "$proj" && -z "${live[$b]:-}" && -z "$resv" ]] && continue     # пустые блоки не печатаем
    lp="$(live_ports | awk -v x="$b" '$1>=x && $1<=x+9' | tr '\n' ' ')"
    if   [[ -n "$resv" ]];                          then name="(инфра)";        status="${c_c}reserved${c_0}"
    elif [[ -n "$proj" && -n "${live[$b]:-}" ]];    then name="$proj";           status="${c_g}running${c_0} "
    elif [[ -n "$proj" ]];                          then name="$proj";           status="${c_y}held${c_0}    "
    else                                                 name="${c_r}?незарег.${c_0}"; status="${c_r}live${c_0}    "
    fi
    printf "  %-11s %-14b %-18b %s\n" "${b}-$((b+9))" "$name" "$status" "$lp"
  done

  echo
  local free=()
  for (( b=LO; b<=HI; b+=10 )); do
    [[ -n "${reg[$b]:-}" || -n "${live[$b]:-}" ]] && continue
    is_reserved "$b" && continue
    free+=("$b")
  done
  if (( ${#free[@]} )); then
    printf "${c_c}Свободно:${c_0} %s-%s" "${free[0]}" "$(( free[0]+9 ))"
    (( ${#free[@]} > 1 )) && printf ", далее %s, %s…" "${free[1]}" "${free[2]:-}"
    echo
  else
    echo "${c_r}Свободных блоков нет.${c_0}"
  fi
  echo "${c_d}Новый проект берёт блок командой:${c_0} ports claim <имя>"
}

usage(){
  cat <<EOF
ports — учёт портов проектов (блок из 10 на проект).

  ports map                       карта: занято / зарезервировано / свободно
  ports claim <имя>               забронировать свободный блок (идемпотентно)
  ports claim --from-compose <имя>  то же, но имена портов взять из docker-compose.yml
  ports claim --like <проект> <имя> то же, но набор портов повторить за проектом
  ports which <имя>               показать блок
  ports env <имя>                 переменные блока (порты + COMPOSE_PROJECT_NAME)
  ports run <имя> -- <команда>    запустить команду с этими переменными
  ports free [--force] <имя>      освободить блок
  ports doctor                    проверить конфликты и рассинхрон с живыми портами

Правило: не хардкодь порты — возьми блок через 'ports claim' и поднимай через
'ports run', он подставит номера в окружение. Всё остальное занято соседями.

Стенд проекта и стенд задачи — разные арендаторы: 'myapp' и 'myapp-t16'.
У каждого свой блок, свои контейнеры и свои тома; гасить задачу нужно с
'-v', иначе её тома останутся на диске.
EOF
}

case "${1:-map}" in
  map|"")   cmd_map ;;
  claim)    shift; cmd_claim "$@" ;;
  free)     shift; cmd_free  "$@" ;;
  which)    shift; cmd_which "$@" ;;
  env)      shift; cmd_env   "$@" ;;
  run)      shift; cmd_run   "$@" ;;
  doctor)   cmd_doctor ;;
  -h|--help|help) usage ;;
  *) die "Неизвестная команда '$1'. Смотри: ports --help" ;;
esac
