<script>
const S = {};
const el = (t, a = {}, ...kids) => {
  const n = document.createElement(t);
  for (const [k, v] of Object.entries(a)) {
    if (k === 'class') n.className = v; else if (k === 'text') n.textContent = v;
    else if (k.startsWith('on')) n.addEventListener(k.slice(2), v); else n.setAttribute(k, v);
  }
  for (const kid of kids) if (kid) n.append(kid);
  return n;
};
const sel = (opts, value, onchange) => {
  const s = el('select', { onchange });
  for (const o of opts) {
    const v = typeof o === 'string' ? o : o.value;
    const t = typeof o === 'string' ? o : o.label;
    s.append(el('option', { value: v, text: t, ...(v === value ? { selected: 'selected' } : {}) }));
  }
  return s;
};
const field = (name, control) => el('label', { class: 'f' }, document.createTextNode(name), control);

function afterOptions(step) {
  const out = [{ value: 'no', label: 'нет' }, { value: 'yes', label: 'после любого хода' }];
  for (const o of step.outcomes) out.push({ value: 'o:' + o, label: 'после исхода «' + o + '»' });
  return out;
}
const afterValue = (a) => a === true ? 'yes' : (Array.isArray(a) && a.length ? 'o:' + a[0] : 'no');
const afterFrom = (v) => v === 'yes' ? true : (v.startsWith('o:') ? [v.slice(2)] : false);

function stepCard(chain, step, i) {
  const opts = S.options;
  const models = () => opts.models[step.agent] || [];
  const efforts = () => [{ value: '', label: 'не задано' }].concat(
    (opts.efforts[step.agent] || []).map((e) => ({ value: e, label: e })));
  const card = el('div', { class: 'step' });
  const redraw = () => { render(); };

  const up = el('button', { class: 'ghost tiny', title: 'выше', text: '↑',
    onclick: () => { if (i > 0) { const s = chain.steps; [s[i - 1], s[i]] = [s[i], s[i - 1]]; touch(chain); redraw(); } } });
  const down = el('button', { class: 'ghost tiny', title: 'ниже', text: '↓',
    onclick: () => { const s = chain.steps; if (i < s.length - 1) { [s[i + 1], s[i]] = [s[i], s[i + 1]]; touch(chain); redraw(); } } });
  up.disabled = i === 0; down.disabled = i === chain.steps.length - 1;

  card.append(el('div', { class: 'shead' },
    el('span', { class: 'num', text: String(i + 1) }),
    el('span', { class: 'sid', text: step.id }),
    el('span', { class: 'srole', text: 'роль prompts/' + step.prompt_file + '.md' }),
    el('div', { class: 'move' }, up, down)));

  const grid = el('div', { class: 'grid' });
  grid.append(field('агент', sel(opts.agents, step.agent, (e) => {
    step.agent = e.target.value;
    if (!(opts.models[step.agent] || []).includes(step.model)) step.model = (opts.models[step.agent] || [''])[0];
    if (step.effort && !(opts.efforts[step.agent] || []).includes(step.effort)) step.effort = '';
    touch(chain); redraw();
  })));
  const known = models().includes(step.model) ? models() : models().concat([step.model]);
  grid.append(field('модель', sel(known, step.model, (e) => { step.model = e.target.value; touch(chain); })));
  grid.append(field('усилие', sel(efforts(), step.effort, (e) => { step.effort = e.target.value; touch(chain); })));
  grid.append(field('память', sel(opts.contexts, step.context, (e) => { step.context = e.target.value; touch(chain); })));
  const runs = el('input', { type: 'number', min: '1', max: '20', value: String(step.max_runs) });
  runs.addEventListener('input', () => { step.max_runs = Number(runs.value); touch(chain); });
  grid.append(field('заходов', runs));
  grid.append(field('ворота', sel(afterOptions(step), afterValue(step.after), (e) => {
    step.after = afterFrom(e.target.value); touch(chain); redraw();
  })));
  card.append(grid);

  const ask = el('input', { type: 'checkbox' });
  ask.checked = step.ask;
  ask.addEventListener('change', () => { step.ask = ask.checked; touch(chain); });
  card.append(el('div', { class: 'flags' },
    el('label', {}, ask, document.createTextNode('роль может спросить вас в чате'))));

  const flow = [];
  for (const [outcome, target] of Object.entries(step.next))
    flow.push(outcome === '*' ? 'далее: ' + target : outcome + ' → ' + target);
  if (step.artifact.length) flow.push('пишет: ' + step.artifact.join(', '));
  if (step.moves.length && step.after !== false) flow.push('кнопки возврата: ' + step.moves.join(', '));
  if (step.moves.length && step.after === false) flow.push('кнопки возврата уйдут вместе с воротами');
  card.append(el('div', { class: 'flow', text: flow.join(' · ') }));
  return card;
}

// Правка отмечается без перерисовки: она стёрла бы курсор в поле «заходов»
// на первой же цифре. Перерисовываются только те правки, что меняют состав
// полей: агент (другой список моделей), ворота, порядок шагов.
const touch = (chain) => { chain.dirty = true; chain.msg = ''; if (chain.onDirty) chain.onDirty(); };
const steps_word = (n) => {
  const ten = n % 100, one = n % 10;
  const word = (ten >= 11 && ten <= 14) ? 'шагов' : (one === 1 ? 'шаг' : (one >= 2 && one <= 4 ? 'шага' : 'шагов'));
  return n + ' ' + word;
};

function chainBlock(chain) {
  const box = el('details', { class: 'chain' });
  if (chain.open) box.setAttribute('open', 'open');
  box.addEventListener('toggle', () => { chain.open = box.open; });
  const tags = [];
  if (chain.custom) tags.push(el('span', { class: 'tag', text: 'правлена' }));
  if (chain.dirty) tags.push(el('span', { class: 'tag', text: 'не сохранено' }));
  box.append(el('summary', {},
    el('span', { class: 'cname', text: chain.name }),
    el('span', { class: 'srole', text: steps_word(chain.steps.length) }), ...tags));
  if (chain.error) {
    box.append(el('div', { class: 'cdesc' }, el('span', { class: 'msg bad', text: chain.error })));
    return box;
  }
  if (chain.description) box.append(el('div', { class: 'cdesc', text: chain.description }));
  const steps = el('div', { class: 'steps' });
  chain.steps.forEach((s, i) => steps.append(stepCard(chain, s, i)));
  box.append(steps);

  const msg = el('span', { class: 'msg ' + (chain.bad ? 'bad' : 'ok'), text: chain.msg || '' });
  const saveBtn = el('button', { text: 'Сохранить', onclick: () => send(chain, '') });
  saveBtn.disabled = !chain.dirty;
  const dirtyTag = el('span', { class: 'tag', text: 'не сохранено' });
  chain.onDirty = () => {
    saveBtn.disabled = false;
    msg.textContent = '';
    if (!dirtyTag.isConnected) box.querySelector('summary').append(dirtyTag);
  };
  const resetBtn = el('button', { class: 'ghost', text: 'Сбросить до заводских',
    onclick: () => { if (confirm('Удалить пользовательскую версию цепочки ' + chain.name + '?')) send(chain, '/reset'); } });
  resetBtn.disabled = !chain.custom;
  box.append(el('div', { class: 'bar' }, saveBtn, resetBtn, msg));
  return box;
}

async function send(chain, suffix) {
  const body = suffix ? '{}' : JSON.stringify({ steps: chain.steps });
  const r = await fetch('/api/chains/' + encodeURIComponent(chain.name) + suffix,
    { method: 'POST', headers: { 'Content-Type': 'application/json' }, body });
  const answer = await r.json().catch(() => ({ error: 'ответ не разобрал' }));
  const open = new Set(S.data.chains.filter((c) => c.open).map((c) => c.name));
  if (!r.ok) { chain.bad = true; chain.msg = answer.error || ('ошибка ' + r.status); render(); return; }
  await load(open, { name: chain.name, msg: suffix ? 'сброшено до заводской' : 'сохранено', bad: false });
}

async function load(open = new Set(), flash = null) {
