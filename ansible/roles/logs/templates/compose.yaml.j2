# Управляется Ansible: roles/logs/templates/compose.yaml.j2
# Правки здесь переживут ровно до следующей выкатки.
#
# Журналы контейнеров в браузере. Он ничего не хранит: ни базы, ни файлов,
# ни истории — просто читает поток от Docker и показывает. Отсюда и вес:
# меньше 15 МБ памяти в покое.
#
# ПРО ДОСТУП К СОКЕТУ DOCKER И ОТСУТСТВИЕ ПАРОЛЯ.
#
# Сокет монтируем только на чтение (:ro): контейнер не может ни запустить,
# ни остановить, ни изменить ничего на машине — только читать список
# контейнеров и их журналы. Но «быть участником частной сети» и «иметь вход
# на машину» — не одно и то же: правила Tailscale дают сетевой доступ,
# а вход по SSH даёт ключ в servers.yml, и ключей там наперечёт. То есть
# любой участник сети без ключа получает журналы ВСЕХ контейнеров машины —
# включая агентские сессии — без единого пароля. Сегодня участник сети
# на этой машине один — её владелец. Если участников станет больше, вопрос
# придётся решать явно (DOZZLE_AUTH_PROVIDER или список фильтров), а не
# считать закрытым по умолчанию.

name: vps-dev-logs

services:
  dozzle:
    image: {{ logs_image }}
    container_name: {{ logs_container_name }}
    restart: unless-stopped
    ports:
      # Только адрес частной сети, не 0.0.0.0.
      #
      # Известная тонкость: при загрузке машины Docker и Tailscale стартуют
      # параллельно, и адрес частной сети появляется примерно на секунду
      # позже. Проиграет контейнер эту гонку — не займёт адрес и уйдёт
      # в перезапуск по restart-политике, то есть вернётся сам, просто
      # чуть позже. Для просмотрщика журналов это терпимо.
      - "{{ logs_tailscale_address }}:{{ logs_port }}:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    environment:
      # Показывать все контейнеры, а не только помеченные особо.
      DOZZLE_FILTER: ""
      DOZZLE_NO_ANALYTICS: "true"
    read_only: true
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    healthcheck:
      test: ["CMD", "/dozzle", "healthcheck"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    mem_limit: {{ logs_memory_limit }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
