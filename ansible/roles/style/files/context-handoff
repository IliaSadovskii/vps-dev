#!/usr/bin/env python3
"""Хук PostToolUse Claude Code: субагенту с большим контекстом — напоминание о передаче.

    context-handoff [ПОРОГ=500000] [ШАГ=100000]   (вход хука — JSON на stdin)

Агент не видит размер своего контекста, а каждый его ход перечитывает контекст
целиком. Хук берёт размер из журнала субагента — usage последней записи
assistant (input + cache_read + cache_creation) — и с порога возвращает
additionalContext: дойти до устойчивой точки, записать передачу, вернуть
мастеру «нужен преемник». Повторяет не на каждом вызове, а после роста ещё на
ШАГ. В основной сессии (во входе нет agent_id) молчит. Любая ошибка — тихий
выход 0: хук не должен ломать работу агента.

transcript_path во входе субагента (Claude Code 2.1.311) — журнал основной
сессии, отдельного пути для PostToolUse нет; журнал субагента лежит рядом:
<сессия>/subagents/agent-<agent_id>.jsonl. Журнал пишется с запаздыванием, и
хук может увидеть размер прошлого хода — на пороге в сотни тысяч это не важно.
Когда уже напоминали — в ~/.cache/context-handoff/<agent_id>.
"""
import json
import os
import re
import sys
import time

STATE_DIR = os.path.expanduser("~/.cache/context-handoff")
STATE_TTL = 3 * 86400
CHUNK = 256 * 1024

# Что входит в передачу, — в правилах общего промпта (prompt-work.md.j2 роли
# style); здесь только повод и ссылка, чтобы знание жило в одном месте.
REMINDER = (
    "context-handoff: контекст этого субагента — {size}k токенов (порог {limit}k), "
    "и каждый ход перечитывает его целиком. По правилу передачи из общего промпта "
    "(~/.claude/CLAUDE.md): дойди до ближайшей устойчивой точки, закоммить, запиши "
    "раздел «Передача» в файл плана (нет файла — в сам ответ) и верни ответ, первая "
    "строка которого — «нужен преемник»."
)


def journal_path(hook):
    """Журнал субагента: свой путь, если CLI его дал, иначе рядом с журналом сессии."""
    agent_id = hook["agent_id"]
    own = hook.get("agent_transcript_path")
    if own:
        return own
    main = hook["transcript_path"]
    if os.path.basename(main) == f"agent-{agent_id}.jsonl":
        return main
    session_dir = os.path.splitext(main)[0]
    return os.path.join(session_dir, "subagents", f"agent-{agent_id}.jsonl")


def context_size(path):
    """Размер контекста последнего хода: идём с конца файла кусками до записи с usage."""
    with open(path, "rb") as journal:
        end = journal.seek(0, os.SEEK_END)
        tail = b""
        while end > 0:
            start = max(0, end - CHUNK)
            journal.seek(start)
            tail = journal.read(end - start) + tail
            end = start
            lines = tail.split(b"\n")
            # Первая строка куска может быть обрезана — разбираем её на следующем круге.
            tail, complete = (lines[0], lines[1:]) if start else (b"", lines)
            for raw in reversed(complete):
                if b'"usage"' not in raw:
                    continue
                try:
                    entry = json.loads(raw)
                except ValueError:
                    continue
                usage = (entry.get("message") or {}).get("usage") or {}
                if entry.get("type") != "assistant" or not usage:
                    continue
                size = sum(int(usage.get(key) or 0) for key in (
                    "input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
                if size:
                    return size
    return 0


def last_reminded(state):
    try:
        with open(state, encoding="utf-8") as fh:
            return int(fh.read().strip() or 0)
    except (OSError, ValueError):
        return None


def remember(state, size):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    now = time.time()
    for name in os.listdir(STATE_DIR):
        old = os.path.join(STATE_DIR, name)
        if now - os.path.getmtime(old) > STATE_TTL:
            os.unlink(old)
    with open(state, "w", encoding="utf-8") as fh:
        fh.write(str(size))


def main():
    hook = json.load(sys.stdin)
    agent_id = hook.get("agent_id")
    if not agent_id or not re.fullmatch(r"[A-Za-z0-9_-]+", agent_id):
        return
    limit = int(sys.argv[1]) if len(sys.argv) > 1 else 500_000
    step = int(sys.argv[2]) if len(sys.argv) > 2 else 100_000

    size = context_size(journal_path(hook))
    if size < limit:
        return
    state = os.path.join(STATE_DIR, agent_id)
    before = last_reminded(state)
    if before is not None and size < before + step:
        return
    remember(state, size)
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": REMINDER.format(size=size // 1000, limit=limit // 1000),
    }}, ensure_ascii=False))


if __name__ == "__main__":
    try:
        main()
    except Exception:  # noqa: BLE001 — хук не должен ломать работу агента
        pass
    sys.exit(0)
