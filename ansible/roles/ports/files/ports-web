    [[ -n "$project_path" && -z "${PROJECT_ACTIVE[$g]:-}" ]] && project_hidden=" hidden"
    printf '<section class="%s" data-project="%s" data-active="%s"%s><div class="projecthead"><h2>%s</h2>' \
      "$gclass" "$(printf '%s' "$project_path" | esc)" "${PROJECT_ACTIVE[$g]:-0}" "$project_hidden" "$(esc <<<"$g")"
    # Группа от живого старого контейнера может пережить каталог после rm -rf.
    # Для неё не рисуем редактор: API принимает только существующий корень.
    if [[ -n "$project_path" ]]; then
      printf '<button class="bookmark-toggle" type="button" aria-expanded="false">☆ Закладки</button>'
    fi
    printf '</div><div class="rows">\n'
    last_stand="__нет__"
    project_has_rows=0
    while IFS=$'\x1f' read -r p group name desc web stand; do
      [[ "$group" == "$g" ]] || continue
      project_has_rows=1
      if [[ "$stand" != "$last_stand" ]]; then
        if [[ -n "$stand" ]]; then
          printf '  <div class="stand">задача %s</div>\n' "$(printf '%s' "$stand" | esc)"
        else
          printf '  <div class="stand">основной стенд</div>\n'
        fi
        last_stand="$stand"
      fi
      ename="$(printf '%s' "$name" | esc)"; edesc="$(printf '%s' "$desc" | esc)"
      eicon="$(icon_for "$p" "$web" "$group" | esc)"
      if [[ "$web" == 1 ]]; then
        printf '  <a class="row" href="https://%s:%s/" target="_blank" rel="noopener"><span class="icon">%s</span><span class="name">%s</span><span class="desc">%s</span><span class="port">%s</span></a>\n' \
          "$dnsname" "$p" "$eicon" "$ename" "$edesc" "$p"
      else
        printf '  <div class="row int"><span class="icon">%s</span><span class="name">%s</span><span class="desc">%s</span><span class="port">%s</span></div>\n' \
          "$eicon" "$ename" "$edesc" "$p"
      fi
    done < <(ordered_rows | sort -t$'\x1f' -k6,6 -k1,1n)
    printf '</div>\n'
    # Даже чистый репозиторий — полезная секция: в ней живёт список сред и
    # админок. Сообщение отличает его от ошибки загрузки страницы.
    if [[ "$project_has_rows" == 0 ]]; then
      printf '<p class="empty-project">Сервисы не запущены</p>\n'
    fi
    if [[ -n "$project_path" ]]; then
      printf '<div class="bookmark-panel" hidden data-project="%s"><div class="bookmark-loading">Загружаю закладки…</div></div>\n' \
        "$(printf '%s' "$project_path" | esc)"
    fi
    printf '</section>\n'
    continue
  fi

  printf '<section class="%s"><h2>%s</h2><div class="grid">\n' "$gclass" "$(esc <<<"$g")"
  # внутри группы: сначала веб, по возрастанию порта
  while IFS=$'\x1f' read -r p group name desc web stand; do
    [[ "$group" == "$g" ]] || continue
    # Страница настройки чужой службы карточки не получает: к ней ведёт
