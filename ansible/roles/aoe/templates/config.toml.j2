# Заготовка от Ansible: roles/aoe/templates/config.toml.j2.
# Кладётся один раз, дальше файлом владеет сам aoe (настройки в TUI по «s»
# и в веб-панели пишут сюда) — повторный прогон его не трогает.

[session]
