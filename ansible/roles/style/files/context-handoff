#!/usr/bin/env -S python3 -I -S
"""Хук PostToolUse Claude Code: субагенту с большим контекстом — напоминание о передаче.

    context-handoff ПОРОГ ШАГ   (токены; вход хука — JSON на stdin)

Агент не видит размер своего контекста, а каждый его ход перечитывает контекст
целиком. Хук берёт размер из журнала субагента — usage последней записи
assistant (input + cache_read + cache_creation) — и с ПОРОГА возвращает
additionalContext: выполнить правило передачи из общего промпта. Повторяет не
на каждом вызове, а после роста ещё на ШАГ; контекст уменьшился (автосжатие) —
отсчёт заново. В основной сессии (во входе нет agent_id) молчит. Любая ошибка,
нет или кривые аргументы — тихий выход 0: хук не должен ломать работу агента.

transcript_path во входе субагента (Claude Code 2.1.311) — журнал основной
сессии; журнал субагента лежит рядом: <сессия>/subagents/agent-<agent_id>.jsonl.
Журнал пишется с запаздыванием, и хук может увидеть размер прошлого хода — на
пороге в сотни тысяч это не важно. Читается только хвост журнала, не больше
TAIL_LIMIT. Когда уже напоминали — в ~/.cache/context-handoff/<agent_id>.
Только stdlib, запуск с -I -S: на каждом вызове инструмента не грузим site.
"""
import json
import os
import re
import sys
import tempfile
import time

STATE_DIR = os.path.expanduser("~/.cache/context-handoff")
STATE_TTL = 3 * 86400
CHUNK = 256 * 1024
TAIL_LIMIT = 16 * 1024 * 1024

# Что делать — только в правиле общего промпта (prompt-work.md.j2 роли style).
REMINDER = (
    "context-handoff: контекст этого субагента — {size}k токенов (порог {limit}k){again}. "
    "Выполни правило передачи по порогу контекста из общего промпта (~/.claude/CLAUDE.md)."
)


def journal_path(hook):
    session_dir = os.path.splitext(hook["transcript_path"])[0]
    return os.path.join(session_dir, "subagents", f"agent-{hook['agent_id']}.jsonl")


def usage_size(line):
    """Размер контекста из строки журнала или 0, если это не запись assistant с usage."""
    if b'"usage"' not in line:
        return 0
    try:
        entry = json.loads(line)
    except ValueError:
        return 0
    usage = (entry.get("message") or {}).get("usage") or {}
    if entry.get("type") != "assistant" or not usage:
        return 0
    return sum(int(usage.get(key) or 0) for key in (
        "input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))


def lines_from_end(path):
    """Строки файла с конца, но не дальше TAIL_LIMIT байт. Куски длинной строки
    копятся списком и склеиваются один раз, когда строка закончилась."""
    with open(path, "rb") as journal:
        end = journal.seek(0, os.SEEK_END)
        floor = max(0, end - TAIL_LIMIT)
        pending = []  # куски незаконченной строки, от конца к началу
        while end > floor:
            start = max(floor, end - CHUNK)
            journal.seek(start)
            chunk = journal.read(end - start)
            end = start
            parts = chunk.split(b"\n")
            if len(parts) == 1:
                pending.append(chunk)
                continue
            yield parts[-1] + b"".join(reversed(pending))
            yield from reversed(parts[1:-1])
            pending = [parts[0]]
        if end == 0 and pending:
            yield b"".join(reversed(pending))


def context_size(path):
    for line in lines_from_end(path):
        size = usage_size(line)
        if size:
            return size
    return 0


def last_reminded(state):
    try:
        with open(state, encoding="utf-8") as fh:
            return int(fh.read().strip())
    except (OSError, ValueError):
        return None


def remember(state, size):
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    now = time.time()
    for entry in os.scandir(STATE_DIR):
        try:
            if entry.is_file(follow_symlinks=False) and now - entry.stat(follow_symlinks=False).st_mtime > STATE_TTL:
                os.unlink(entry.path)
        except OSError:
            pass
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=".tmp-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(str(size))
        os.replace(tmp, state)
    except BaseException:
        os.unlink(tmp)
        raise


def positive(arg):
    value = int(arg)
    if value <= 0:
        raise ValueError(arg)
    return value


def main():
    if len(sys.argv) != 3:
        return
    try:
        limit, step = positive(sys.argv[1]), positive(sys.argv[2])
    except ValueError:
        return
    hook = json.load(sys.stdin)
    agent_id = hook.get("agent_id")
    if not isinstance(agent_id, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", agent_id):
        return

    size = context_size(journal_path(hook))
    if size < limit:
        return
    state = os.path.join(STATE_DIR, agent_id)
    before = last_reminded(state)
    if before is not None and size < before:
        before = None  # контекст сжался — отсчёт заново
    if before is not None and size < before + step:
        return
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PostToolUse",
        "additionalContext": REMINDER.format(
            size=size // 1000, limit=limit // 1000, again=", повторно" if before is not None else ""),
    }}, ensure_ascii=False), flush=True)
    remember(state, size)


if __name__ == "__main__":
    try:
        main()
    except Exception:  # noqa: BLE001 — хук не должен ломать работу агента
        pass
    sys.exit(0)
