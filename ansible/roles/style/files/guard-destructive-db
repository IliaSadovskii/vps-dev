#!/usr/bin/env bash
# Сторож команд, которые стирают базу или уводят artisan в чужое окружение.
# Повод: 2026-09-21 config:cache и 2026-10-02 migrate:fresh --env=testing
# стёрли базу общего стенда listate-crm. Такие команды запускает человек сам,
# кроме удаления тестовых баз CRM — см. crm_test_db.
# Защита от ошибки агента, а не от умысла. Примеры решений — scripts/test-guard.sh.
input=$(cat)
cmd=$(jq -r '.tool_input.command // empty' <<<"$input")
[ -z "$cmd" ] && exit 0
cwd=$(jq -r '.cwd // empty' <<<"$input")
# Перевод строки — как пробел: иначе grep видит команду по кускам.
low=$(printf '%s' "$cmd" | tr '[:upper:]' '[:lower:]' | tr '\n' ' ' | sed -E 's/[[:space:]]+$//')

deny() {
  echo "Заблокировано сторожем (guard-destructive-db): $1. Такие команды запускает владелец сам — попроси его." >&2
  exit 2
}

has() { grep -Eq "$1" <<<"$low"; }

# Тестовые базы CRM агент удаляет сам (выбор владельца 2026-11-06). Разрешён
# только список: вся команда — одно удаление базы с именем из тестовых, в
# тестовом Postgres CRM на этой машине. Всё, что не подошло, идёт под запрет ниже.
crm_test_db() {
  local name='(listate_test[a-z0-9_]*|bench[a-z0-9_]*|[a-z0-9_]+_volume|agency_[0-9a-f]{32})'
  local client='( -u [a-z0-9_]+| -d [a-z0-9_]+| -q| -at)*'
  local psql="psql$client -c ['\"]drop database (if exists )?\"?$name\"?( with \\(force\\))?;?['\"]"
  local dropdb="dropdb( -u [a-z0-9_]+| --if-exists| --force| -f)* $name"
  has "^docker exec( -[a-z]+)* listate-([a-z]-)?postgres-1 ($psql|$dropdb)\$" && return 0
  case "$cwd" in
    /projects/listate-crm|/projects/listate-crm/*|/projects/.stands/listate-crm-*)
      has "^docker compose exec( -[a-z]+)* postgres ($psql|$dropdb)\$" && return 0 ;;
  esac
  return 1
}

if has 'artisan'; then
  has '(migrate:(fresh|reset|rollback|refresh)|db:wipe|db:seed[^|;&]*--force)' && deny "команда artisan стирает или откатывает базу"
  has '(config:cache|[[:space:]]optimize([^:a-z]|$))' && deny "кэш конфига увёл тесты в боевую базу 2026-09-21"
  has 'artisan[^|;&]*--env([= ])' && deny "artisan с --env берёт .env стенда, если файла окружения нет"
fi

has '(^|[;&|[:space:]])make[[:space:]]+([^|;&]*[[:space:]])?fresh([[:space:]]|$)' && deny "make fresh пересоздаёт базу стенда"

if has '(psql|pg_|dropdb)' && ! crm_test_db; then
  has '(drop[[:space:]]+(table|schema|database|owned)|truncate[[:space:]]|dropdb|pg_restore[^|;&]*(--clean|-c))' && deny "SQL стирает таблицы или базу (тестовую базу CRM — listate_test*, bench*, *_volume, agency_<hex> — удаляй одной командой: docker exec listate[-<полоса>]-postgres-1 dropdb -U <пользователь> <имя> или из папки CRM docker compose exec postgres dropdb …; make clean-test убирает всё сразу; агентство контура — в консоли платформы)"
fi

has 'docker[^|;&]*(volume[[:space:]]+(rm|prune)|system[[:space:]]+prune)' && deny "удаление томов docker уносит базу"

# ports run — второй стенд со своими томами; контур и платформа им не становятся.
if has 'down[^|;&]*([[:space:]]-v([[:space:]]|$)|--volumes)' && { ! has 'ports run' || has 'contour|ports run listate-platform'; }; then
  deny "docker compose down -v без ports run сносит том общего стенда"
fi
exit 0
