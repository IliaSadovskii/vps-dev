#!/usr/bin/env python3
# vps-dev-cache-gc — еженедельная уборка кэшей, которые Docker-уборка
# (vps-dev-docker-gc) не трогает: они не про Docker и не про осиротевшие
# проекты, а про накопленный кэш инструментов на самой машине.
#
# Раз в неделю, не каждый день: npm-кэш выгоднее не трогать лишний раз —
# сегодняшняя установка использует то, что скачала вчерашняя, и ежедневный
# снос обнулял бы эту экономию без всякой выгоды по месту (кэш не растёт
# настолько быстро). Раз в неделю — баланс между «не копится месяцами» и
# «не грузим сеть заново каждый день».
#
# Что чистим и почему это безопасно:
#
#  1. `npm cache clean --force` от имени каждого владельца кэша — npm сам
#     перекачает недостающее при следующей установке, это именно кэш, а не
#     состояние. Владельцев двое: дев-пользователь (его npm, его npx) и
#     root — от root каждый прогон Ansible обновляет CLI агентов
#     (roles/agents, `npm update --global`), и кэш root за месяц дорос до
#     6,6 ГБ. Чистится от имени самого владельца, а не чужим — иначе
#     файлы в кэше сменили бы хозяина.
#  1а. ~/.npm/_npx — пакеты, скачанные `npx`. `npm cache clean` его не
#     трогает (лежит рядом с _cacache, а не в нём), а это гигабайты: каждая
#     версия ACP-адаптера или opencode — свой каталог на 300–700 МБ.
#     Снимаются все, кроме тех, из которых прямо сейчас что-то запущено:
#     следующий `npx` скачает своё заново.
#  2. `apt-get clean` — скачанные .deb остаются в /var/cache/apt/archives
#     даже после установки; `apt-get install` их перекачает при надобности.
#  3. `journalctl --vacuum-time=` — системный журнал старше срока. Активные
#     журналы служб (aoe, paseo, ...) читаются через их же `journalctl -u`,
#     это не трогает.
#
# Ничего из этого не тексты разговоров, не БД проектов, не рабочие копии —
# только то, что любой из инструментов создаст заново сам, без участия
# человека, при следующей надобности.

import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone

DEPLOY_USER = os.environ.get("CACHEGC_DEPLOY_USER", "dev")
JOURNAL_KEEP_DAYS = int(os.environ.get("CACHEGC_JOURNAL_KEEP_DAYS", "14"))
LOG_FILE = os.environ.get("CACHEGC_LOG_FILE", "/var/lib/vps-dev/dockergc/cachegc.log")
DRY_RUN = "--dry-run" in sys.argv or os.environ.get("CACHEGC_DRY_RUN") == "1"


def run(*args):
    return subprocess.run(list(args), capture_output=True, text=True)


def mutate(*args):
    if DRY_RUN:
        print("(dry-run) " + " ".join(args))
        return subprocess.CompletedProcess(args, 0, "", "")
    return run(*args)


def du(path):
    res = run("du", "-sb", path)
    try:
        return int(res.stdout.split()[0])
    except (IndexError, ValueError):
        return None


def human(bytes_before, bytes_after):
    if bytes_before is None or bytes_after is None:
        return ""
    freed = max(0, bytes_before - bytes_after)
    return f"{freed / 1024 / 1024:.0f} МБ"


def running_paths():
    """Каталоги, из которых сейчас запущены процессы: cwd и командная строка."""
    paths = []
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        try:
            paths.append(os.readlink(f"/proc/{pid}/cwd"))
            with open(f"/proc/{pid}/cmdline", "rb") as f:
                paths.extend(f.read().decode(errors="replace").split("\0"))
        except OSError:
            continue
    return paths


def clean_npx(npx_dir, busy):
    removed = 0
    for entry in sorted(os.listdir(npx_dir)):
        path = os.path.join(npx_dir, entry)
        if any(p.startswith(path) for p in busy):
            continue
        size = du(path) or 0
        if DRY_RUN:
            print(f"(dry-run) rm -rf {path}  # {size / 1024 / 1024:.0f} МБ")
        else:
            shutil.rmtree(path, ignore_errors=True)
        removed += size
    return removed


def main():
    report = []
    busy = running_paths()

    for user, home in ((DEPLOY_USER, f"/home/{DEPLOY_USER}"), ("root", "/root")):
        npm_dir = f"{home}/.npm"
        if not os.path.isdir(npm_dir):
            continue
        before = du(npm_dir)
        npx_dir = f"{npm_dir}/_npx"
        npx_freed = clean_npx(npx_dir, busy) if os.path.isdir(npx_dir) else 0
        if DRY_RUN:
            cache = du(f"{npm_dir}/_cacache") or 0
            print(f"(dry-run) npm cache clean --force от {user}  # {cache / 1024 / 1024:.0f} МБ")
            report.append(f"npm-кэш {user}: освободилось бы {(cache + npx_freed) / 1024 / 1024:.0f} МБ")
            continue
        mutate("runuser", "-u", user, "--", "npm", "cache", "clean", "--force")
        freed = human(before, du(npm_dir))
        if freed:
            report.append(f"npm-кэш {user} (с _npx): освобождено {freed}")

    apt_dir = "/var/cache/apt"
    before = du(apt_dir)
    mutate("apt-get", "clean")
    after = du(apt_dir)
    freed = human(before, after)
    if freed:
        report.append(f"apt-кэш: освобождено {freed}")

    res = mutate("journalctl", f"--vacuum-time={JOURNAL_KEEP_DAYS}d")
    for line in (res.stdout + res.stderr).splitlines():
        if "freed" in line.lower() or "vacuuming" in line.lower():
            report.append(f"журнал systemd: {line.strip()}")

    for line in report:
        print(line)
    if DRY_RUN:
        return
    os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%SZ")
    with open(LOG_FILE, "a", encoding="utf-8") as f:
        f.write(f"=== {stamp} ===\n")
        f.write("\n".join(report) if report else "нечего убирать")
        f.write("\n")


if __name__ == "__main__":
    main()
