# Управляется Ansible: roles/ntfy/templates/compose.yaml.j2
# Правки здесь переживут ровно до следующей выкатки.
#
# Свой сервер уведомлений вместо публичного ntfy.sh: на публичном сервере
# топик — по сути пароль (угадал строку — читаешь всё), а сюда летят
# заголовки задач и вопросы агентов. Свой сервер за Tailscale снимает
# этот риск: снаружи частной сети до него не достать вообще, поэтому
# внутри самого ntfy отдельная аутентификация не включена — границу
# держит Tailscale, а не пароль на топик.

name: vps-dev-ntfy

services:
  ntfy:
    image: {{ ntfy_image }}
    container_name: {{ ntfy_container_name }}
    restart: unless-stopped
    # У образа ntfy нет команды по умолчанию — serve запускает веб- и
    # приёмный сервер (в отличие от ntfy publish/subscribe — это клиентские
    # команды того же бинарника, здесь не нужны).
    command: serve
    ports:
      # Только loopback: в частную сеть отдаёт ports-web с TLS на том же
      # номере порта (см. roles/logs, тот же принцип). Именно этот адрес,
      # https://<машина>.ts.net:{{ ntfy_port }}, вписывается в приложение ntfy
      # на телефоне. Heartbeat с самой машины ходит по loopback.
      - "127.0.0.1:{{ ntfy_port }}:80"
    volumes:
      - {{ ntfy_volume }}:/var/cache/ntfy
    environment:
      # Адрес, каким сервер виден снаружи, — нужен для вложений и ссылок
      # в уведомлениях. Снаружи он только один: через tailscale serve.
      NTFY_BASE_URL: "{{ ntfy_base_url }}"
      # За обратным прокси: лимиты считать по X-Forwarded-For, а не по
      # адресу прокси, иначе все клиенты выглядят одним.
      NTFY_BEHIND_PROXY: "true"
      NTFY_CACHE_FILE: /var/cache/ntfy/cache.db
      # Сутки-двое: это оповещения, а не архив. Старые сообщения ntfy
      # подчищает сам, по расписанию внутри процесса.
      NTFY_CACHE_DURATION: "{{ ntfy_cache_duration }}"
    security_opt:
      - no-new-privileges:true
    cap_drop:
      - ALL
    mem_limit: {{ ntfy_memory_limit }}
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"

volumes:
  {{ ntfy_volume }}:
