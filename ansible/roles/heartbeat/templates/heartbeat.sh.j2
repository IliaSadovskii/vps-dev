#!/usr/bin/env bash
# Управляется Ansible: roles/heartbeat/templates/heartbeat.sh.j2
#
# Проверяет место на диске и ключевые службы. В отличие от стука
# на healthchecks.io (так делает листейт), здесь не «дозвон, что жив»,
# а именно уведомление о беде: молчание — норма, шуметь в ntfy на каждый
# штатный прогон незачем и быстро приучило бы канал игнорировать.

set -uo pipefail

# Адрес сервера уведомлений узнаём В МОМЕНТ ЗАПУСКА, а не подставляем при
# настройке. Две причины, и обе про то, чтобы не сломаться молча:
#
#   1. ntfy слушает только адрес машины в частной сети (не loopback) —
#      см. roles/ntfy. Адрес этот выдаёт Tailscale, и он может смениться:
#      после пересоздания машины, после переподключения к сети. Вписанный
#      при настройке адрес в этот день перестал бы работать, а узнали бы
#      мы об этом ровно тогда, когда впервые понадобилось уведомление.
#
#   2. Роль heartbeat идёт в site.yml РАНЬШЕ роли ntfy, и на момент
#      её выполнения адрес ещё не известен вовсе.
#
# ntfy_topic — это имя темы, а не готовый адрес: сервер свой, и адрес
# у него один на все темы.
ts_ip="$(tailscale ip -4 2>/dev/null | head -1)"
if [ -z "$ts_ip" ]; then
    echo "машина не в частной сети — уведомление отправить некуда." >&2
    exit 1
fi
URL="http://${ts_ip}:{{ ntfy_port }}/{{ ntfy_topic }}"

problems=""

free_percent=$(( 100 - $(df --output=pcent / | tail -1 | tr -dc '0-9') ))
if [ "$free_percent" -lt {{ heartbeat_disk_free_min_percent }} ]; then
    problems="${problems}на диске осталось ${free_percent}%; "
fi

{% for svc in heartbeat_watched_services %}
systemctl is-active --quiet {{ svc }} || problems="${problems}{{ svc }} не работает; "
{% endfor %}

[ -f /var/run/reboot-required ] && problems="${problems}нужна перезагрузка; "

# Беды нет — молчим и выходим успешно. Именно этот случай (не отправлять
# вовсе) отличает присмотр от дозвона healthchecks.io, где пришлось бы
# отчитываться и в отсутствие проблем.
if [ -z "$problems" ]; then
    exit 0
fi

# Неудачу отправки НЕ проглатываем. Если сервер ntfy недоступен или тема
# удалена, служба должна закончиться ошибкой, а не тихо сообщить systemd
# про success, когда уведомление на самом деле никуда не ушло — иначе беда
# на машине останется без единого следа где бы то ни было. Причину печатаем
# сами: код возврата curl человеку в журнале ничего не скажет.
if ! curl -fsS -m 10 --retry 3 \
    -H "Title: {{ inventory_hostname }}: есть беда" \
    -H "Priority: high" \
    -H "Tags: warning" \
    -d "$problems" \
    "$URL" >/dev/null; then
    echo "уведомление не доставлено: ntfy не принял запрос." >&2
    echo "Проверь, что тема ещё существует и адрес совпадает с ntfy_topic." >&2
    exit 1
fi
