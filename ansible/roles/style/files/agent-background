#!/bin/sh
# PreToolUse:Agent — фон или нет, решает глубина вызова.
#
# Главная сессия: только фон. Синхронный субагент держит чат, пока не
# закончит, и владелец не может ни спросить о ходе, ни дать новое задание.
#
# Внутри субагента: только явно синхронно. В `claude -p` и Agent SDK
# субагент ждёт лишь синхронных детей; фоновый доложит в главную сессию мимо
# него, и его итога в отчёте субагента не будет (code.claude.com/docs/en/
# sub-agents, «Let subagents spawn their own subagents», 2026-11-24).
# Умолчание для вложенных документация не называет, поэтому false — явно.
#
# Признак глубины — agent_id во входе: он есть только у вызова из субагента.
# Примеры решений — scripts/test-agent-background.sh.
in=$(cat)
bg=$(printf '%s' "$in" | jq -r '.tool_input.run_in_background | if . == null then "unset" else tostring end' 2>/dev/null)
aid=$(printf '%s' "$in" | jq -r '.agent_id // ""' 2>/dev/null)

if [ -n "$aid" ]; then
  [ "$bg" = "false" ] && exit 0
  echo 'Ты субагент: дочернего запускай синхронно — "run_in_background": false. Фоновый доложит мимо тебя, и его итога в твоём отчёте не будет.' >&2
  exit 2
fi
[ "$bg" = "true" ] && exit 0
echo 'Субагент из главной сессии — только в фоне: добавь "run_in_background": true и повтори. Синхронный держит чат до конца работы.' >&2
exit 2
