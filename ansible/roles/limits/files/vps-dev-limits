PROVIDERS = [
    {"id": "claude", "name": "Claude", "icon": "🟠", "probe": probe_claude,
     "source": "api.anthropic.com/api/oauth/usage"},
    {"id": "codex", "name": "Codex", "icon": "⚫", "probe": probe_codex,
     "source": "журналы сессий ~/.codex"},
    {"id": "zai", "name": "z.ai (GLM)", "icon": "🔵", "probe": probe_zai,
     "source": "api.z.ai/api/monitor/usage/quota/limit"},
]


# --------------------------------------------------------------- опрос и кэш --

class Snapshot:
    """Последнее известное состояние. Держим отдельно «свежий ответ» и
    «последние цифры»: поставщик может замолчать, а показать всё равно есть что."""

    def __init__(self):
        self.lock = threading.Lock()
        self.cards = {}
        self.generated_at = 0.0
        self.load()

    def load(self):
        try:
            with open(CACHE_FILE, encoding="utf-8") as f:
                saved = json.load(f)
            self.cards = {c["id"]: c for c in saved.get("providers", []) if isinstance(c, dict) and c.get("id")}
            self.generated_at = saved.get("generated_at", 0.0)
            # После перезапуска службы цифры на экране не должны выглядеть
            # свежее, чем они есть: до первого удачного опроса они прошлые.
            for card in self.cards.values():
                if card.get("status") == OK:
                    card["status"] = STALE
        except FileNotFoundError:
            pass
        except (OSError, json.JSONDecodeError, TypeError) as e:
            log(f"кэш не прочитан ({e}) — начинаю с пустого")

    def save(self):
        # Атомарно: страницу отдаёт этот же процесс, но файл переживает
        # перезапуск, и оборванная запись стоила бы всей истории.
        tmp = CACHE_FILE + ".tmp"
        try:
            os.makedirs(STATE_DIR, exist_ok=True)
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.payload(), f, ensure_ascii=False)
            os.replace(tmp, CACHE_FILE)
        except OSError as e:
            log(f"кэш не сохранён: {e}")

    def update(self, provider, result=None, error=None):
        with self.lock:
            card = self.cards.get(provider["id"], {})
            card.update({
                "id": provider["id"],
                "name": provider["name"],
                "icon": provider["icon"],
                "source": provider["source"],
                "checked_at": time.time(),
            })
            if result is not None:
                card.update({
                    "status": OK,
                    "message": "",
                    "windows": result["windows"],
                    "plan": result.get("plan", ""),
                    "as_of": result.get("as_of", time.time()),
                })
            else:
                card["message"] = error.message
                # Прошлые цифры оставляем на месте: «неделя 17 %, снято час
                # назад» полезнее пустой карточки. Но статус честный.
                if error.status == OFF:
                    card["status"] = OFF
                    card["windows"] = card.get("windows") or []
                elif card.get("windows"):
                    card["status"] = STALE
                else:
                    card["status"] = ERROR
                    card["windows"] = []
            self.cards[provider["id"]] = card
            self.generated_at = time.time()

    def payload(self):
        order = {p["id"]: i for i, p in enumerate(PROVIDERS)}
        cards = sorted(self.cards.values(), key=lambda c: order.get(c.get("id"), 99))
        return {"generated_at": self.generated_at, "providers": cards}


def save_raw(name, data):
    """Сырой ответ поставщика — для разбора руками, когда формат не узнан."""
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(os.path.join(STATE_DIR, name), "w", encoding="utf-8") as f:
            json.dump(data, f, ensure_ascii=False, indent=1)
    except (OSError, TypeError):
        pass


def poll_once(snapshot):
    secrets = read_secrets()
    for provider in PROVIDERS:
        try:
            snapshot.update(provider, result=provider["probe"](secrets))
        except ProviderError as e:
            snapshot.update(provider, error=e)
        except Exception as e:  # noqa: BLE001 — падать целиком из-за одного поставщика нельзя
            log(f"{provider['id']}: непредвиденная ошибка\n{traceback.format_exc()}")
            snapshot.update(provider, error=ProviderError(f"непредвиденная ошибка: {e}"))
    snapshot.save()


def poll_loop(snapshot):
    while True:
        try:
            poll_once(snapshot)
        except Exception:  # noqa: BLE001 — поток опроса не должен умирать никогда
            log(f"круг опроса сорвался\n{traceback.format_exc()}")
        time.sleep(POLL_SECONDS)


# ------------------------------------------------------------------ страница --

def human_left(epoch):
    if not epoch:
        return ""
    left = epoch - time.time()
    if left <= 0:
        return "вот-вот"
    hours, minutes = int(left // 3600), int(left % 3600 // 60)
    if hours >= 24:
        return f"через {hours // 24} дн. {hours % 24} ч."
    if hours:
        return f"через {hours} ч. {minutes} мин."
    return f"через {minutes} мин."


def human_when(epoch):
    if not epoch:
        return ""
    return datetime.fromtimestamp(epoch).strftime("%H:%M")


def human_ago(epoch):
    if not epoch:
        return "никогда"
    ago = time.time() - epoch
    if ago < 90:
        return "только что"
    if ago < 3600:
        return f"{int(ago // 60)} мин. назад"
    if ago < 86400:
        return f"{int(ago // 3600)} ч. назад"
    return datetime.fromtimestamp(epoch).strftime("%d.%m %H:%M")


def heat(percent):
    # Пороги словами: зелёный до двух третей, жёлтый до 85 %, дальше красный.
    return "hot" if percent >= 85 else "warm" if percent >= 60 else "cool"


def esc(text):
    return html.escape(str(text or ""), quote=True)


def render(payload):
    cards = payload["providers"]
    parts = [f"""<!doctype html><html lang="ru"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<meta http-equiv="refresh" content="{POLL_SECONDS}">
<title>Лимиты подписок</title>
<style>
 /* Тот же язык, что у дашборда служб (:8062): карточки в сетке, цвет темы
    берётся из системной, страница самодостаточна — без внешних запросов. */
 :root{{color-scheme:light dark;--line:color-mix(in srgb,currentColor 14%,transparent);--accent:#2563eb}}
 *{{box-sizing:border-box}}
 body{{font:15px/1.5 system-ui,-apple-system,sans-serif;max-width:940px;margin:0 auto;padding:1.75rem 1rem 3rem}}
 h1{{font-size:1.3rem;margin:0 0 .25rem}}
 .sub{{opacity:.55;font-size:.85rem;margin:0 0 1.75rem}}
 .grid{{display:grid;gap:.75rem;grid-template-columns:repeat(2,1fr)}}
 @media(max-width:720px){{.grid{{grid-template-columns:1fr}}}}
 .card{{display:flex;flex-direction:column;gap:.55rem;padding:.95rem 1.05rem;
       border:1px solid color-mix(in srgb,var(--accent) 22%,var(--line));border-radius:14px;
       background:color-mix(in srgb,var(--accent) 5%,transparent)}}
 .card.off{{opacity:.62;border-style:dashed;background:none}}
 .head{{display:flex;align-items:baseline;gap:.5rem}}
 .icon{{font-size:1.1rem}}
 .name{{font-weight:600;color:var(--accent)}}
 .plan{{opacity:.5;font-size:.78rem;margin-left:auto;font-variant-numeric:tabular-nums}}
 .bar{{display:flex;flex-direction:column;gap:.2rem}}
 .bar .row{{display:flex;gap:.5rem;font-size:.82rem}}
 .bar .row .left{{margin-left:auto;opacity:.55;white-space:nowrap}}
 .track{{height:.5rem;border-radius:.25rem;background:color-mix(in srgb,currentColor 12%,transparent);overflow:hidden}}
 .fill{{height:100%;border-radius:.25rem}}
 .cool .fill{{background:#16a34a}} .warm .fill{{background:#f59e0b}} .hot .fill{{background:#dc2626}}
 .pct{{font-variant-numeric:tabular-nums;opacity:.75}}
 .msg{{font-size:.82rem;opacity:.7;overflow-wrap:anywhere}}
 .msg.bad{{color:#dc2626;opacity:.85}}
 .foot{{margin-top:.2rem;padding-top:.5rem;border-top:1px solid var(--line);font-size:.72rem;opacity:.45;overflow-wrap:anywhere}}
 @media(prefers-color-scheme:dark){{:root{{--accent:#7aa7ff}} .msg.bad{{color:#f87171}}}}
</style></head><body>
<h1>Лимиты подписок</h1>
<div class="sub">обновляется раз в {POLL_SECONDS} с · страница сама перечитывается · {esc(human_ago(payload['generated_at']))} последний круг</div>
<div class="grid">"""]

    for card in cards:
        klass = "card off" if card.get("status") == OFF else "card"
        parts.append(f'<div class="{klass}">')
        plan = f'<span class="plan">{esc(card.get("plan"))}</span>' if card.get("plan") else ""
        parts.append(f'<div class="head"><span class="icon">{esc(card.get("icon"))}</span>'
                     f'<span class="name">{esc(card.get("name"))}</span>{plan}</div>')

        for w in card.get("windows") or []:
            left = human_left(w.get("resets_at"))
            when = human_when(w.get("resets_at"))
            tail = f"сброс {left} ({when})" if left and when else (w.get("note") or "")
            parts.append(
                f'<div class="bar {heat(w["percent"])}">'
                f'<div class="row"><span>{esc(w["label"])}</span>'
                f'<span class="pct">{w["percent"]:.0f}%</span>'
                f'<span class="left">{esc(tail)}</span></div>'
                f'<div class="track"><div class="fill" style="width:{w["percent"]:.1f}%"></div></div>'
                f'</div>')

        status = card.get("status")
        if card.get("message"):
            bad = " bad" if status == ERROR else ""
            parts.append(f'<div class="msg{bad}">{esc(card["message"])}</div>')
        if status == STALE and card.get("as_of"):
            parts.append(f'<div class="msg">показаны прошлые цифры, сняты {esc(human_ago(card["as_of"]))}</div>')
        elif status == OK and card.get("id") == "codex" and card.get("as_of"):
            # У Codex «свежесть» — это когда он в последний раз работал.
            parts.append(f'<div class="msg">цифры на момент последнего запроса, {esc(human_ago(card["as_of"]))}</div>')

        parts.append(f'<div class="foot">{esc(card.get("source"))}</div></div>')

    if not cards:
        parts.append('<div class="card"><div class="msg">первый круг опроса ещё идёт</div></div>')

    parts.append("</div></body></html>")
    return "".join(parts)


class Handler(BaseHTTPRequestHandler):
    server_version = "vps-dev-limits"
    snapshot = None

    def do_GET(self):  # noqa: N802 — имя задано BaseHTTPRequestHandler
        path = self.path.split("?", 1)[0].rstrip("/") or "/"
        if path == "/":
            payload = self.snapshot.payload()
            self.reply(200, "text/html; charset=utf-8", render(payload).encode("utf-8"))
        elif path == "/api/limits":
            body = json.dumps(self.snapshot.payload(), ensure_ascii=False, indent=1).encode("utf-8")
            self.reply(200, "application/json; charset=utf-8", body)
        elif path == "/healthz":
            self.reply(200, "text/plain; charset=utf-8", b"ok\n")
        else:
            self.reply(404, "text/plain; charset=utf-8", "нет такой страницы\n".encode("utf-8"))

    def reply(self, code, ctype, body):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        # Страница живёт минуту — ровно до следующего круга опроса.
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(body)
        except BrokenPipeError:
            pass  # закрыли вкладку посреди ответа — не повод для записи в журнал

    def log_message(self, fmt, *args):
        pass  # каждый запрос в журнал не пишем: страница сама перечитывается раз в минуту


def main():
    os.makedirs(STATE_DIR, exist_ok=True)
    snapshot = Snapshot()
    Handler.snapshot = snapshot
    threading.Thread(target=poll_loop, args=(snapshot,), daemon=True).start()
    # Только loopback: в частную сеть отдаёт ports-web с TLS на том же порту.
    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    log(f"слушаю 127.0.0.1:{PORT}, опрос раз в {POLL_SECONDS} с")
    server.serve_forever()


if __name__ == "__main__":
    main()
