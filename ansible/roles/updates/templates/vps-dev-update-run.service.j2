# Управляется Ansible: roles/updates/templates/vps-dev-update-run.service.j2
#
# Исполнитель заданий со страницы обновлений. Сам не запускается: его
# будит vps-dev-update-run.path, когда в очереди появляется файл.
[Unit]
Description=Обновить службу по заданию со страницы обновлений
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# От root: задание — это выкатка роли, она пишет в /usr и /etc и
# перезапускает службы. Изоляции здесь намеренно нет, в отличие от
# страницы: та только кладёт задание в файл.
User=root
Environment=UPDATES_STATE_DIR={{ updates_state_dir }}
Environment=UPDATES_OVERRIDES_FILE={{ updates_overrides_file }}
Environment=UPDATES_REPO_DIR={{ updates_repo_dir }}
Environment=UPDATES_USER={{ updates_user }}
# Прогон роли kandev или aoe занимает минуты, но не десятки: если
# застряли — лучше оборвать и показать это в журнале, чем висеть вечно.
TimeoutStartSec=1800
ExecStart={{ updates_install_dir }}/vps-dev-update-run
