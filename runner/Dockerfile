# Ansible в контейнере: на сервере разработки ничего не ставится,
# а версия инструмента одинакова у всех и не зависит от того,
# что установлено на машине.

# Образ закреплён отпечатком, а не только меткой. Метка 3.22 переезжает
# на новые сборки, и вместе с ними меняется набор пакетов в репозитории:
# точная версия ansible=11.6.0-r0 в нём просто исчезает, и сборка падает
# с «нет такого пакета». То есть обещание «через полгода соберётся то же
# самое» без отпечатка не выполняется — сборка вообще не проходит.
#
# Обновлять осознанно: docker pull alpine:3.22 и сюда новый отпечаток.
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce

# Версии закреплены: пересборка образа через полгода не должна принести
# другой Ansible и другое поведение.
RUN apk add --no-cache \
        ansible=11.6.0-r0 \
        ansible-lint=24.12.2-r0 \
        openssh-client \
        jq \
        # passlib нужен фильтру хеширования паролей. Без неё задача
        # установки пароля root падает с невнятным сообщением.
        # Отдельная зависимость появилась потому, что встроенный модуль
        # crypt объявлен устаревшим и убран из свежих версий Python.
        py3-passlib \
    && rm -rf /var/cache/apk/*

# Наборы модулей и готовые роли ставим при сборке образа, а не при каждом
# запуске: иначе каждый прогон начинается с двухминутной загрузки.
#
# Кладём в общесистемные каталоги, а не в домашний каталог root: контейнер
# запускается от пользователя хозяина, и до /root он не достучится.
# Пути к ролям задаются в ansible/ansible.cfg, а не здесь: переменная
# окружения перебивала бы файл настроек, и правка в нём не действовала бы.
#
# SCAN_SYS_PATH выключен: иначе Ansible находит ещё и коллекции, встроенные
# в пакет Alpine, и при каждом запуске предупреждает о двух версиях.
# Побеждают закреплённые нами, но шум мешает видеть настоящие замечания.
ENV ANSIBLE_COLLECTIONS_PATH=/usr/share/ansible/collections \
    ANSIBLE_COLLECTIONS_SCAN_SYS_PATH=False

# Один файл на образ и на машину (roles/pull ставит те же наборы на сервер),
# поэтому лежит в ansible/, а образ собирается из корня репозитория.
COPY ansible/requirements.yml /tmp/requirements.yml
RUN ansible-galaxy collection install -r /tmp/requirements.yml \
        -p /usr/share/ansible/collections \
    && ansible-galaxy role install -r /tmp/requirements.yml \
        -p /usr/share/ansible/roles \
    && chmod -R a+rX /usr/share/ansible \
    && rm /tmp/requirements.yml

WORKDIR /work
