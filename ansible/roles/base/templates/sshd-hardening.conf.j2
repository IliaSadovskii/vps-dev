# Управляется Ansible: roles/base/templates/sshd-hardening.conf.j2
# Правки здесь будут стёрты при следующем `make apply`.

PubkeyAuthentication yes

# Пароли выключены полностью. Перебор паролей — основной способ взлома
# сервера, стоящего в интернете (даже когда наружу смотрит только порт 22).
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no

# Вход под root закрыт целиком, БЕЗ prohibit-password (root по ключу без
# пароля). У {{ base_deploy_user }} есть NOPASSWD sudo — отдельный root-вход
# по SSH ничего не добавляет к тому, что уже можно сделать через sudo, зато
# держит вторую живую точку входа с правами суперпользователя, которую
# отдельно от первой отслеживать и закрывать. Для аварий — пароль root
# и веб-консоль провайдера (см. user.yml), они не зависят от sshd вообще.
PermitRootLogin no

# Белый список: любая будущая системная учётка, которой кто-то по ошибке
# положит ключ, не получит вход автоматически. Пускаем ровно того, кто нужен.
AllowUsers {{ base_deploy_user }}

# 6, а не 3: клиент перебирает несколько ключей в связке (ssh-agent, разные
# ключи для разных серверов) прежде чем дойти до нужного, и заниженный
# порог рвёт соединение раньше, чем очередь ключей закончится.
MaxAuthTries 6
LoginGraceTime 30

# Обрыв повисшей сессии: около 10 минут молчания (300 c × 2 попытки).
ClientAliveInterval 300
ClientAliveCountMax 2

X11Forwarding no

# Не резолвить обратный DNS подключающегося: на серверах без записи PTR
# это просто ожидание таймаута резолвера при каждом входе.
UseDNS no
