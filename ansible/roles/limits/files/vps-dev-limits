def log(msg):
    # В journal: служба под systemd, свой файл журнала заводить незачем.
    print(f"vps-dev-limits: {msg}", flush=True)


# ------------------------------------------------------------------- утилиты --

def read_secrets():
    """Ключи из providers.env. Читаем на каждом круге, а не при старте:
    вписал ключ — увидел цифры, перезапускать службу не нужно."""
    out = {}
    try:
        with open(SECRETS_FILE, encoding="utf-8") as f:
            for line in f:
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                key, _, value = line.partition("=")
                out[key.strip()] = value.strip().strip("'\"")
    except FileNotFoundError:
        pass
    except OSError as e:
        log(f"providers.env не прочитан: {e}")
    return out


def opencode_keys():
    """Ключи планов, уже подключённых в OpenCode (`opencode auth login`), —
    чтобы один и тот же ключ не пришлось вписывать второй раз руками. Имена
    поставщиков там меняются от версии к версии (zhipuai, zai-coding-plan,
    glm-…), поэтому ищем по куску имени, а не по точному совпадению."""
    path = os.path.join(HOME, ".local", "share", "opencode", "auth.json")
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        return {}
    except (OSError, json.JSONDecodeError) as e:
        log(f"auth.json OpenCode не прочитан: {e}")
        return {}

    out = {}
    for name, entry in (data.items() if isinstance(data, dict) else []):
        if isinstance(entry, dict):
            key = entry.get("key") or entry.get("apiKey") or entry.get("api_key")
            if key:
                out[str(name).lower()] = key
    return out


def key_for(secrets, own_name, opencode_hints, env_names=()):
    """Ключ поставщика: сначала свой файл (там правят руками, и это главнее),
    потом OpenCode, потом окружение службы."""
    if secrets.get(own_name):
        return secrets[own_name]
    for name, key in opencode_keys().items():
        if any(hint in name for hint in opencode_hints):
            return key
    for env_name in env_names:
        if os.environ.get(env_name):
            return os.environ[env_name]
    return None


def http_json(url, headers, timeout=HTTP_TIMEOUT):
    """GET с разбором JSON. Ошибку возвращаем текстом, понятным на карточке,
    а не трассировкой: её читает человек, а не разработчик."""
    req = urllib.request.Request(url, headers=headers, method="GET")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            body = resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        detail = ""
        try:
            detail = e.read().decode("utf-8", "replace")[:200]
        except Exception:
            pass
        raise ProviderError(f"ответ {e.code} от {urlhost(url)}", http_status=e.code, detail=detail)
    except urllib.error.URLError as e:
        raise ProviderError(f"нет связи с {urlhost(url)}: {e.reason}")
    except socket.timeout:
        raise ProviderError(f"{urlhost(url)} не ответил за {timeout} с")
    try:
        return json.loads(body)
    except json.JSONDecodeError:
        raise ProviderError(f"{urlhost(url)} ответил не JSON")


def urlhost(url):
    m = re.match(r"https?://([^/]+)", url)
    return m.group(1) if m else url


class ProviderError(Exception):
    """Понятная человеку причина, почему карточка без свежих цифр."""

    def __init__(self, message, http_status=None, detail="", status=ERROR):
        super().__init__(message)
        self.message = message
        self.http_status = http_status
        self.detail = detail
        self.status = status


def window(label, percent, resets_at=None, note=""):
    """Одна полоска. percent — сколько израсходовано, 0..100."""
    try:
        percent = float(percent)
    except (TypeError, ValueError):
        percent = 0.0
    return {
        "label": label,
        "percent": max(0.0, min(100.0, percent)),
        "resets_at": resets_at,
        "note": note,
    }


def iso_to_epoch(value):
    """ISO-время из ответа → epoch. Ни один поставщик не обязан присылать
    именно ISO, поэтому неразобранное — это None, а не исключение."""
    if not value:
        return None
    if isinstance(value, (int, float)):
        return epoch_guess(value)
    try:
        return datetime.fromisoformat(str(value).replace("Z", "+00:00")).timestamp()
    except ValueError:
        return None


def epoch_guess(value):
    """Секунды или миллисекунды — поставщики шлют и то, и другое
    (у z.ai время сброса приходит в миллисекундах, у Codex — в секундах)."""
    try:
        value = float(value)
    except (TypeError, ValueError):
        return None
    if value <= 0:
        return None
    return value / 1000.0 if value > 1e11 else value


# ---------------------------------------------------------------- поставщики --

def probe_claude(secrets):
    """Claude Code. Токен берём из файла, который пишет сам CLI, и только читаем:
    обновлять его нельзя — обновляет Claude Code, а два писателя одного файла
    однажды затрут друг другу свежую сессию."""
    path = os.path.join(HOME, ".claude", ".credentials.json")
    try:
        with open(path, encoding="utf-8") as f:
            creds = json.load(f)
    except FileNotFoundError:
        raise ProviderError("нет входа: выполни claude /login в терминале", status=OFF)
    except (OSError, json.JSONDecodeError) as e:
        raise ProviderError(f"файл входа не прочитан: {e}")

    oauth = creds.get("claudeAiOauth") or {}
    token = oauth.get("accessToken")
    if not token:
        raise ProviderError("в файле входа нет токена: выполни claude /login", status=OFF)

    try:
        data = http_json(
            "https://api.anthropic.com/api/oauth/usage",
            {
                "Authorization": f"Bearer {token}",
                "anthropic-beta": "oauth-2025-04-20",
                "Content-Type": "application/json",
                "User-Agent": "vps-dev-limits",
            },
        )
    except ProviderError as e:
        if e.http_status in (401, 403):
            # Токен живёт часами и обновляется при работе агента. Если он протух,
            # чинится это запуском claude, а не нашими руками.
            raise ProviderError("сессия истекла: запусти claude, он обновит вход", status=OFF)
        raise

    windows = []
    # limits[] — уже готовый список окон, включая недельные по моделям.
    # Формат старше и стабильнее, чем именованные ключи, поэтому он первый.
    for item in data.get("limits") or []:
        kind = item.get("kind") or ""
        scope = (item.get("scope") or {}).get("model") or {}
        model = scope.get("display_name")
        if kind == "session":
            label = "5 ч."
        elif kind == "weekly_all":
            label = "Неделя"
        elif kind == "weekly_scoped":
            label = f"Неделя · {model}" if model else "Неделя · часть моделей"
        else:
            label = kind or "лимит"
        windows.append(window(label, item.get("percent"), iso_to_epoch(item.get("resets_at"))))

    if not windows:
        for key, label in (("five_hour", "5 ч."), ("seven_day", "Неделя")):
            block = data.get(key) or {}
            if block.get("utilization") is not None:
                windows.append(window(label, block["utilization"], iso_to_epoch(block.get("resets_at"))))

    if not windows:
        raise ProviderError("ответ без лимитов — похоже, формат изменился")

    extra = data.get("extra_usage") or {}
    if extra.get("is_enabled") and extra.get("utilization") is not None:
        windows.append(window("Докупленные", extra["utilization"], None, "extra usage"))

    plan = oauth.get("subscriptionType") or ""
    return {"windows": windows, "plan": plan.replace("_", " "), "as_of": time.time()}


def probe_codex(secrets):
    """Codex CLI. Отдельной точки «сколько осталось» у OpenAI нет: остаток
    приезжает в ответе на каждый запрос, и CLI кладёт его в журнал сессии.
    Поэтому цифра ровно такой свежести, когда Codex последний раз работал —
    время снятия показываем на карточке, чтобы это не выглядело обманом."""
    if not os.path.exists(os.path.join(HOME, ".codex", "auth.json")):
        raise ProviderError("нет входа: выполни codex login в терминале", status=OFF)

    sessions = os.path.join(HOME, ".codex", "sessions")
    files = []
    try:
        for root, _dirs, names in os.walk(sessions):
            for name in names:
                if name.endswith(".jsonl"):
                    path = os.path.join(root, name)
                    try:
                        files.append((os.path.getmtime(path), path))
                    except OSError:
                        continue
    except OSError as e:
        raise ProviderError(f"журналы сессий не прочитаны: {e}")

    if not files:
        raise ProviderError("Codex ещё не работал на этой машине", status=OFF)

    # Свежие файлы первыми; заглядываем в несколько, потому что последняя
    # сессия могла оборваться до первого ответа модели и остаться без лимитов.
    files.sort(reverse=True)
    found = None
    for _mtime, path in files[:8]:
        found = last_rate_limits(path)
        if found:
            break
    if not found:
        raise ProviderError("в журналах сессий ещё нет цифр лимита", status=OFF)

    limits, as_of = found
    windows = []
    for key, fallback in (("primary", "5 ч."), ("secondary", "Неделя")):
        block = limits.get(key)
        if not isinstance(block, dict) or block.get("used_percent") is None:
            continue
        windows.append(window(
            window_label(block.get("window_minutes"), fallback),
            block.get("used_percent"),
            epoch_guess(block.get("resets_at")),
        ))
    if not windows:
        raise ProviderError("в журналах сессий ещё нет цифр лимита", status=OFF)

    credits = limits.get("credits") or {}
    if credits.get("unlimited"):
        windows.append(window("Кредиты", 0, None, "без ограничения"))
    elif credits.get("has_credits"):
        windows.append(window("Кредиты", 0, None, f"остаток {credits.get('balance')}"))

    return {"windows": windows, "plan": limits.get("plan_type") or "", "as_of": as_of}


def last_rate_limits(path, tail_bytes=512 * 1024):
    """Последняя запись rate_limits в журнале сессии. Файл читаем с хвоста:
    журнал долгой сессии — это мегабайты, а нужна одна последняя строка."""
    try:
        size = os.path.getsize(path)
        with open(path, "rb") as f:
            if size > tail_bytes:
                f.seek(size - tail_bytes)
                f.readline()  # обрезанную по середине строку выбрасываем
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return None

    for line in reversed(lines):
        if '"rate_limits"' not in line:
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError:
            continue
        limits = find_key(record, "rate_limits")
        # Записи бывают и пустые (limit_id «premium» приходит с primary: null) —
        # такая нам не годится, ищем дальше вглубь журнала.
        if isinstance(limits, dict) and (limits.get("primary") or limits.get("secondary")):
            return limits, iso_to_epoch(record.get("timestamp")) or os.path.getmtime(path)
    return None


def find_key(obj, key, depth=0):
    """Значение ключа где-то внутри вложенного ответа. Пути в чужих форматах
    меняются от версии к версии, имя ключа — гораздо реже."""
    if depth > 6:
        return None
    if isinstance(obj, dict):
        if key in obj:
            return obj[key]
        for value in obj.values():
            found = find_key(value, key, depth + 1)
            if found is not None:
                return found
    elif isinstance(obj, list):
        for value in obj:
            found = find_key(value, key, depth + 1)
            if found is not None:
                return found
    return None


def probe_zai(secrets):
    """z.ai (планы GLM). Своего файла входа на машине нет: ключ берётся из
    OpenCode, если план подключён там, или из providers.env.
    Точка недокументированная, поэтому разбираем её мягко: не нашли знакомых
    полей — не выдумываем цифры, а говорим об этом и кладём сырой ответ
    в zai-last.json, чтобы разбор можно было дописать по факту."""
    key = key_for(secrets, "ZAI_API_KEY", ("zai", "z-ai", "zhipu", "glm", "bigmodel"),
                  ("ZAI_API_KEY", "ZHIPUAI_API_KEY"))
    if not key:
        raise ProviderError("нет ключа: подключи план в OpenCode (opencode auth login) "
                            f"или впиши ZAI_API_KEY в {SECRETS_FILE}", status=OFF)

    # Площадок у z.ai две — глобальная и китайская (open.bigmodel.cn),
    # ручка на обеих одна и та же, отличается только хост.
    base = (secrets.get("ZAI_API_BASE") or "https://api.z.ai").rstrip("/")
    data = http_json(
        base + "/api/monitor/usage/quota/limit",
        {"Authorization": f"Bearer {key}", "Accept": "application/json", "User-Agent": "vps-dev-limits"},
    )
    save_raw("zai-last.json", data)

    if isinstance(data, dict) and data.get("code") not in (0, None, 200):
        raise ProviderError(f"z.ai отказал: {data.get('msg') or data.get('code')}")

    payload = data.get("data") if isinstance(data, dict) else data
    windows = zai_windows(payload)
    if not windows:
        raise ProviderError("ответ получен, но полей лимита в нём не нашлось "
                            "(сырой ответ — в zai-last.json)")
    return {"windows": windows, "plan": str(find_key(payload, "planName") or find_key(payload, "plan")
                                            or find_key(payload, "level") or ""),
            "as_of": time.time()}


# Имена полей в недокументированной точке z.ai разнятся по версиям, поэтому
# на каждое значение — список кандидатов, а не одно имя. Реальный формат
# (снят с ответа 2026-09): limits[] с полями currentValue (израсходовано),
# usage (размер окна), percentage (целый, округлённый), nextResetTime (мс),
# а окно задано парой unit+number (3=часы, 6=недели).
ZAI_PERCENT_KEYS = ("usedPercent", "usagePercent", "percent", "usedRate", "rate", "used_percent")
ZAI_RESET_KEYS = ("resetTime", "resetAt", "nextResetTime", "refreshTime", "reset_time")
ZAI_WINDOW_KEYS = ("windowMinutes", "duration", "period", "interval", "window", "limitType", "type")
ZAI_UNIT_MINUTES = {3: 60, 6: 60 * 24 * 7}


def zai_windows(payload):
    entries = []
    if isinstance(payload, dict):
        for value in payload.values():
            if isinstance(value, list) and all(isinstance(v, dict) for v in value):
                entries.extend(value)
        if not entries:
            entries = [payload]
    elif isinstance(payload, list):
        entries = [v for v in payload if isinstance(v, dict)]

    windows = []
    for entry in entries:
        percent = zai_percent(entry)
        if percent is None:
            continue
        windows.append(window(
            zai_label(entry),
            percent,
            epoch_guess(first_key(entry, ZAI_RESET_KEYS)),
        ))
    return windows


def zai_percent(entry):
    """Сколько процентов окна израсходовано. Точная пара currentValue/usage
    даёт дробные проценты, поэтому она первая; поле percentage — целое
    и округлённое (6 из 2000 приходило как 1), оно только запасной путь."""
    used = first_key(entry, ("currentValue", "used", "usedTokens", "consumed"))
    total = first_key(entry, ("usage", "total", "limit", "quota"))
    try:
        return float(used) / float(total) * 100.0
    except (TypeError, ValueError, ZeroDivisionError):
        pass
    raw = first_key(entry, ZAI_PERCENT_KEYS)
    try:
        raw = float(raw)
    except (TypeError, ValueError):
        return None
    # Доля приходит и процентами, и долей единицы — отличаем по величине.
    return raw * 100.0 if 0 < raw <= 1 else raw


def zai_label(entry):
    raw = first_key(entry, ZAI_WINDOW_KEYS)
    # Окно у z.ai задаётся парой unit (единица времени) + number (сколько),
    # а не готовой длиной в минутах — переводим и дальше как у всех.
    unit_minutes = ZAI_UNIT_MINUTES.get(entry.get("unit")) if isinstance(entry, dict) else None
    number = entry.get("number") if isinstance(entry, dict) else None
    if unit_minutes and isinstance(number, (int, float)) and number > 0:
        return window_label(unit_minutes * number, str(raw or "лимит"))
    minutes = None
    try:
        minutes = int(raw)
    except (TypeError, ValueError):
        pass
    if minutes:
        return window_label(minutes, str(raw))
    text = str(raw or "лимит")
    return {"TOKENS_LIMIT": "Токены", "CREDIT_LIMIT": "Кредиты", "TIME_LIMIT": "Поиск в вебе"}.get(text, text)


def first_key(entry, keys):
    for key in keys:
        if isinstance(entry, dict) and entry.get(key) is not None:
            return entry[key]
    return None


def window_label(minutes, fallback):
    """Название полоски по длине окна: у всех поставщиков окна свои
    (300 минут, 10080, 30 дней), а человеку нужно «5 часов» и «Неделя»."""
    try:
        minutes = int(minutes)
    except (TypeError, ValueError):
        return fallback
    if minutes <= 0:
        return fallback
    if minutes % (60 * 24) == 0:
        days = minutes // (60 * 24)
        if days == 7:
            return "Неделя"
        if days == 30:
            return "Месяц"
        return f"{days} дн."
    if minutes % 60 == 0:
        return f"{minutes // 60} ч."
    return f"{minutes} мин."


