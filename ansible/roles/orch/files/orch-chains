# Запасные списки: каталог появляется после первого разговора с агентом, а
# страница должна работать и на свежей машине.
FALLBACK_MODELS = {
    "claude": ["opus[1m]", "sonnet", "haiku"],
    "codex": ["gpt-5.6-sol", "gpt-5.6-terra", "gpt-5.5"],
    "opencode": ["zai-coding-plan/glm-5.3"],
}
FALLBACK_EFFORTS = ["low", "medium", "high"]

CONTEXT_TEXT = {
    "fresh": "свежая память",
    "own": "своя прошлая сессия",
    "continue": "сессия прошлого шага",
