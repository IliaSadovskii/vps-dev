#!/usr/bin/env bash
# ports-web — публикует веб-сервисы проектов в tailnet и рисует дашборд.
#
# Исходник — bin/ports-web в репозитории vps; в ~/.local/bin ставит setup-dev.sh,
# запускает по таймеру (см. step_dashboard). Руками звать не нужно.
#
# ЧТО ДЕЛАЕТ.
#  1. Берёт docker-порты, опубликованные на 127.0.0.1, и по ОБРАЗУ контейнера
#     делит их на веб и внутренние (postgres/mysql/redis… → внутренний, наружу
#     не отдаётся). По образу, а не HTTP-пробой: проба капризна на медленных
#     приложениях, образ детерминирован.
#  2. Пишет конфиг общему прокси vps-proxy: на каждый веб-сервис — теневой порт
#     (8XYZ + 1000 = 9XYZ), который сжимает ответы и проставляет Cache-Control
#     на статику с хэшем в имени. Контейнер поднимает setup-dev.sh (step_proxy).
#  3. Каждый веб-сервис отдаёт в tailnet НА ТОМ ЖЕ НОМЕРЕ порта (tailnet :8050 →
#     host :8050) — один номер на сервис, совпадает с `ports map`. Целью ставит
#     теневой порт прокси, если тот слушает, иначе — сам сервис напрямую. Serve
#     правится по дельте (сверяются и состав, и цель), появившиеся/ушедшие
#     подхватывает.
#  4. Генерит index.html со ссылками на все сервисы, сгруппированные по проектам,
#     и отдаёт его в tailnet на :8062. Страница сама обновляется (мета-рефреш) и
#     перегенерируется по таймеру — всегда актуальна.
set -uo pipefail

PORTS_DIR="${PORTS_DIR:-/var/lib/vps-dev/ports}"
STATE_DIR="${STATE_DIR:-/var/lib/vps-dev/ports-web}"
PROJECTS_DIR="${PROJECTS_DIR:-/projects}"
DASH_PORT=8062
PROXY_NAME="${PROXY_NAME:-vps-proxy}"
PROXY_DIR="${PROXY_DIR:-/var/lib/vps-dev/vps-proxy}"
PROXY_OFFSET=1000                    # порт сервиса 8XYZ → теневой порт прокси 9XYZ
PROXY_HEALTH=/_vps-proxy/health      # эту точку отвечает сам прокси, не приложение
mkdir -p "$STATE_DIR"

dnsname="$(tailscale status --json 2>/dev/null | grep -m1 '"DNSName"' | cut -d'"' -f4 | sed 's/\.$//')"
[[ -n "$dnsname" ]] || { echo "ports-web: tailscale не в сети, выхожу" >&2; exit 0; }

# --- инфра-сервисы (не в реестре проектов) ---
declare -A INFRA_LABEL=( [8060]="Dozzle" [8061]="DbGate" [$DASH_PORT]="Дашборд" [8063]="VS Code" [8065]="Agent of Empires"
                         [8066]="Терминал" [8068]="Мониторинг" [8069]="Почта" [8070]="Лимиты"
                         [8071]="Общий промпт" [8072]="Обновления" [8073]="Цепочки orch" [8074]="Закладки проектов" [8075]="Paseo" )
# $DASH_PORT остаётся в трёх массивах ниже (карточки самого дашборда), хотя
# своей карточки в сетке он не получает (см. INFRA_NOCARD) — так строка
# "rows" для него собирается тем же путём, что и для остальной инфры, без
# отдельной ветки только ради одного порта.
declare -A INFRA_DESC=( [8060]="журналы контейнеров, только чтение" [8061]="клиент баз данных проектов" [$DASH_PORT]="эта страница"
                        [8063]="редактор, файлы и терминал в одном окне, открывается в /projects"
                        [8065]="разговор с агентом в браузере, сессии живут в tmux"
                        [8066]="консоль в /projects: с телефона тоже — экранные клавиши и панели"
                        [8068]="процессор, память, диск по машине и контейнерам"
                        [8069]="письма проектов остаются здесь и наружу не уходят"
                        [8070]="сколько израсходовано у подписок агентов за 5 часов и за неделю"
                        [8071]="что все агенты знают до первого слова: как отвечать и что есть на машине"
                        [8072]="что стоит и что вышло у служб машины, обновление кнопкой"
                        [8073]="настройка цепочек оркестратора, открывается шестерёнкой на карточке AoE"
                        [8074]="API закладок на дашборде"
                        [8075]="второй клиент к тем же CLI агентов, что и AoE: веб и телефон" )
# Значок службы на дашборде. Юникод, а не файлы значков: страница остаётся
# одним самодостаточным файлом без внешних запросов.
declare -A INFRA_ICON=( [8060]="📜" [8061]="🗃️" [$DASH_PORT]="🧭" [8063]="💻" [8065]="💬"
                        [8066]="⌨️" [8068]="📊" [8069]="✉️" [8070]="⏳" [8071]="🗣️" [8072]="⬆️"
                        [8073]="⚙️" [8074]="☆" [8075]="📲" )
# Страница настройки чужой карточки: наружу отдаётся (иначе шестерёнка вела бы
# в никуда), но своей карточки не получает — на дашборде это шестерёнка в углу
# той службы, которую страница настраивает.
declare -A INFRA_GEAR=( [8065]=8073 )
# Без карточки в сетке: страница самого дашборда (ссылка сама на себя не
# нужна), Цепочки orch (своя шестерёнка на карточке AoE) и Общий промпт с
# Обновлениями — эти двое теперь одна шестерёнка в углу страницы, две
# вкладки внутри (см. блок $corner_gear ниже).
declare -A INFRA_NOCARD=( [8073]=1 [8071]=1 [8072]=1 [8074]=1 [$DASH_PORT]=1 )
# Куда ведёт ссылка, если не в корень службы. Сейчас пусто — File Browser
# был единственным, кому нужен был путь глубже корня.
declare -A INFRA_PATH=()
# Порядок карточек инфраструктуры на странице — заданный, а не по номеру
# порта: сверху то, чем пользуешься каждый день. Порт, которого здесь нет,
# встанет после перечисленных, по возрастанию номера.
INFRA_ORDER=( 8065 8075 8070 8066 8063 8068 8071 8060 8061 8069 8072 "$DASH_PORT" )
declare -A INFRA_RANK
for _i in "${!INFRA_ORDER[@]}"; do INFRA_RANK[${INFRA_ORDER[$_i]}]=$(( _i + 1 )); done

# --- разбор реестра: порт → проект и порт → человекочитаемое имя сервиса ------
declare -A PORT_PROJECT PORT_LABEL
humanize(){ # имя переменной → имя сервиса (Moscow, App, Web…)
  local t out=() low
  for t in ${1//_/ }; do
    case "${t^^}" in PORT|NGINX|FORWARD) continue;; esac
    low="${t,,}"                       # всё в нижний регистр…
    out+=( "${low^}" )                 # …и первую букву в верхний → Moscow, App, Web
  done
  local s="${out[*]}"; echo "${s:-$1}"
}
shopt -s nullglob
for f in "$PORTS_DIR"/*.env; do
  name="$(basename "$f" .env)"
  while IFS= read -r line; do
    [[ "$line" =~ ^([A-Za-z0-9_]+)=([0-9]+)([[:space:]]*#[[:space:]]*(.*))?$ ]] || continue
    local_key="${BASH_REMATCH[1]}"; local_port="${BASH_REMATCH[2]}"; local_cmt="${BASH_REMATCH[4]}"
    [[ "$local_key" == "BASE_PORT" ]] && continue
    PORT_PROJECT[$local_port]="$name"
    PORT_LABEL[$local_port]="${local_cmt:-$(humanize "$local_key")}"
  done < "$f"
done
shopt -u nullglob

# Карточка проекта не должна зависеть от docker ps: корень репозитория в
# /projects остаётся местом его закладок, даже когда все контейнеры выключены.
# Worktree задач не пролезает сюда — у него .git файл, а не каталог.
declare -A PROJECT_PATH
if [[ -d "$PROJECTS_DIR" ]]; then
  shopt -s nullglob
  for project_dir in "$PROJECTS_DIR"/*; do
    [[ -d "$project_dir" && -d "$project_dir/.git" ]] || continue
    PROJECT_PATH["$(basename "$project_dir")"]="$project_dir"
  done
  shopt -u nullglob
fi

# --- живые сервисы: docker-порты на 127.0.0.1 → образ контейнера -------------
# Веб или внутренний решаем по ОБРАЗУ (postgres/mysql/redis… → внутренний), а не
# по HTTP-пробе: проба капризна (медленный Laravel под нагрузкой таймаутит и
# уезжает в «внутренние»), а образ детерминирован. Слушатели tailscaled на
# tailnet-адресе сюда не попадают — берём только 127.0.0.1 из docker ps.
declare -A PORT_IMAGE PORT_OWNER PORT_SERVICE
while IFS=$'\t' read -r image ports workdir service; do
  # Хозяин порта мимо реестра: каталог проекта из лейбла compose. Проект,
  # поднятый руками (`make up`), реестра не знает, но лейблы у него есть —
  # без них карточка была бы просто «?», и владелец шёл бы разбираться в
  # `docker ps` (разбор 8090-8099 листейта, 2026-09-10).
  while read -r hp; do
    [[ -n "$hp" ]] || continue
    PORT_IMAGE[$hp]="$image"
    [[ -n "$workdir" ]] && PORT_OWNER[$hp]="$(basename "$workdir")"
    [[ -n "$service" ]] && PORT_SERVICE[$hp]="$service"
  done < <(grep -oE '127\.0\.0\.1:8[0-9][0-9][0-9]' <<<"$ports" | grep -oE '8[0-9][0-9][0-9]')
done < <(docker ps --format '{{.Image}}\t{{.Ports}}\t{{.Label "com.docker.compose.project.working_dir"}}\t{{.Label "com.docker.compose.service"}}' 2>/dev/null)
# Службы самого хоста (aoe — systemd, не docker): всё, что слушает
# 127.0.0.1:8xxx и не нашлось среди docker-портов. Образа у них нет, значит
# по DB_RE они не отсеются и попадут в веб — именно это и нужно.
while read -r hp; do
  [[ -n "$hp" && -z "${PORT_IMAGE[$hp]:-}" ]] && PORT_IMAGE[$hp]="host"
done < <(ss -ltnH 2>/dev/null | grep -oE '127\.0\.0\.1:8[0-9][0-9][0-9]\b' | grep -oE '8[0-9][0-9][0-9]$' | sort -u)

DB_RE='postgres|mysql|mariadb|mongo|redis|valkey'
# <title> страницы — только как описание, на классификацию не влияет.
http_title(){ curl -sL -m 3 "http://127.0.0.1:$1/" 2>/dev/null | grep -oiE '<title>[^<]*' | head -1 | sed -E 's/<title>//i; s/^[[:space:]]+//; s/[[:space:]]+$//'; }

# строки: "port|group|name|desc|web(1/0)|stand", разделитель — US (0x1f).
# `group` — проект, `stand` — стенд внутри него: у `myapp-t16` это «t16», у
# самого проекта пусто. Так у проекта одна секция, сколько бы задач ни шло
# параллельно, а не по секции на аренду.
rows=""
for p in $(printf '%s\n' "${!PORT_IMAGE[@]}" | sort -un); do
  img="${PORT_IMAGE[$p]}"; proj="${PORT_PROJECT[$p]:-}"; label="${PORT_LABEL[$p]:-}"; stand=""
  if [[ -n "${INFRA_LABEL[$p]:-}" ]]; then group="инфраструктура"; name="${INFRA_LABEL[$p]}"; desc="${INFRA_DESC[$p]:-}"
  elif [[ -n "$proj" ]];              then group="${proj%-t[0-9]*}"; name="${label:-сервис}"; desc=""
                                           stand="${proj#"${proj%-t[0-9]*}"}"; stand="${stand#-}"
  elif [[ -n "${PORT_OWNER[$p]:-}" ]]; then
    # Чьё это, видно из лейблов, но блок не застолблён: держим карточку в
    # «без реестра» — иначе непорядок растворился бы в секции проекта.
    group="без реестра"; name="${PORT_OWNER[$p]} · ${PORT_SERVICE[$p]:-сервис}"
    desc="блок не застолблён: ports claim ${PORT_OWNER[$p]}"
  else                                     group="без реестра";     name="?"; desc="порт не застолблён (ports claim)"
  fi
  if grep -qiE "$DB_RE" <<<"$img"; then
    web=0; [[ -n "$desc" ]] || desc="внутренний · $img"
  else
    web=1; [[ -n "$desc" ]] || desc="$(http_title "$p")"
  fi
  # Разделитель — US (0x1f), НЕ таб: таб пробельный, и read со IFS=$'\t'
  # схлопывает соседние табы, теряя пустые поля (пустой desc сдвигал бы web).
  printf -v r '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' "$p" "$group" "$name" "$desc" "$web" "$stand"
  rows+="$r"$'\n'
done
# дашборд не docker-порт (его отдаёт tailscaled) — добавляем строку явно
rows+="$(printf '%s\x1f%s\x1f%s\x1f%s\x1f%s' "$DASH_PORT" "инфраструктура" "${INFRA_LABEL[$DASH_PORT]}" "${INFRA_DESC[$DASH_PORT]}" 1)"$'\n'

# Активный контейнер сам показывает проект; остальные каталоги /projects
# остаются скрытыми, пока человек не добавит их в настройках вкладки.
declare -A PROJECT_ACTIVE
while IFS=$'\x1f' read -r p group name desc web stand; do
  [[ -n "$group" && -n "${PROJECT_PATH[$group]:-}" ]] && PROJECT_ACTIVE[$group]=1
done <<<"$rows"

[[ -n "${DEBUG:-}" ]] && { echo "=== ROWS ===" >&2; printf '%s' "$rows" >&2; }

# Порядок карточек внутри группы: сначала веб, потом по рангу из
# INFRA_ORDER (у проектов ранга нет — все равны и сортируются по порту).
# Ранг приписываем первым полем, сортируем и снимаем.
ordered_rows(){
  while IFS=$'\x1f' read -r p group name desc web stand; do
    [[ -n "$p" ]] || continue
    printf '%03d\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\n' \
      "${INFRA_RANK[$p]:-999}" "$p" "$group" "$name" "$desc" "$web" "$stand"
  done <<<"$rows" | sort -t$'\x1f' -k6,6r -k1,1n -k2,2n | cut -d$'\x1f' -f2-
}

# --- веб-сервисы, которые надо отдать наружу -------------------------------
web_ports=()
while IFS=$'\x1f' read -r p group name desc web stand; do
  [[ "$web" == 1 && "$p" != "$DASH_PORT" ]] && web_ports+=("$p")
done <<<"$rows"

# --- 1) конфиг общему прокси (сжатие + кэш статики) -------------------------
# На каждый веб-сервис — блок на теневом порту. Прокси слушает только 127.0.0.1:
# наружу его отдаёт tailscale, как и всё остальное.
#
# Кэш ставим ТОЛЬКО файлам с отпечатком в имени (app-C6yGb0eL.css) внутри папок
# сборки — такое имя меняется вместе с содержимым, и год кэша безопасен. Всё
# остальное не трогаем: на дев-сервере устаревший ответ дороже лишнего запроса.
# Условие про папку и отпечаток — соглашение сборщиков, а не признак стека.
proxy_running(){ [[ "$(docker inspect -f '{{.State.Running}}' "$PROXY_NAME" 2>/dev/null)" == "true" ]]; }

if proxy_running; then
  mkdir -p "$PROXY_DIR"
  cf="$PROXY_DIR/Caddyfile"; cfnew="$cf.new"; cfdirty="$PROXY_DIR/.reload-failed"
  # {8,} в Caddyfile съел бы разбор плейсхолдеров — те же 8 символов классом.
  c='[A-Za-z0-9_-]'
  fingerprint="(?i)/(build|assets|static|dist)/.*-$c$c$c$c$c$c$c$c*\.(js|mjs|css|woff2?|svg|png|jpe?g|webp|avif|gif|ico)$"
  {
    echo "# Сгенерирован ports-web — правки затрутся. Источник: bin/ports-web."
    echo "{"
    echo "	admin 127.0.0.1:2019"
    echo "	auto_https off"
    echo "}"
    for p in "${web_ports[@]}"; do
      echo
      # Адрес без хоста — намеренно. Caddy разбирает адрес блока как «схема,
      # ХОСТ, порт» и матчит запрос по Host; tailscale проксирует с исходным
      # Host (dev-vps…ts.net:8050), под 127.0.0.1 он не подошёл бы, и снаружи
      # приходил бы пустой ответ. Матчим любой Host, а слушаем только loopback —
      # это разные вещи, за адрес отвечает bind ниже.
      #
      # Схема http обязательна: без неё Caddy поднимает порт как HTTPS и отвечает
      # «Client sent an HTTP request to an HTTPS server» — TLS здесь ни к чему,
      # его терминирует tailscale, а до прокси идёт локальный http.
      echo "http://:$(( p + PROXY_OFFSET )) {"
      echo "	bind 127.0.0.1"
      # Признак «прокси жив и это наш блок». Отвечает сам Caddy, не приложение,
      # поэтому проба не зависит от того, поднялось ли уже приложение.
      echo "	respond $PROXY_HEALTH \"ok\" 200"
      # Список типов перечислен явно, без text/*: под text/* попадает
      # text/event-stream, а сжатие потока ломает живые логи (SSE).
      echo "	encode zstd gzip {"
      echo "		match {"
      for ct in text/html text/plain text/css text/javascript text/xml \
                application/json application/javascript application/x-javascript \
                application/xml application/manifest+json image/svg+xml; do
        echo "			header Content-Type $ct*"
      done
      echo "		}"
      echo "	}"
      echo "	@fingerprinted path_regexp $fingerprint"
      echo "	header @fingerprinted Cache-Control \"public, max-age=31536000, immutable\""
      echo "	header X-Vps-Proxy \"$p\""
      # X-Forwarded-Proto приходится задавать явно. По этому заголовку приложение
      # строит абсолютные ссылки на себя, и tailscale присылает сюда https —
      # но Caddy подменяет его СВОЕЙ схемой, а до него идёт локальный http.
      # Приложение начинает верстать ссылки на http://…:8050, которого в tailnet
      # нет (там только TLS), и страница остаётся без стилей.
      # Схема здесь всегда https: единственный вход на сервис — tailscale,
      # а TLS терминирует он.
      echo "	reverse_proxy 127.0.0.1:$p {"
      echo "		header_up X-Forwarded-Proto https"
      echo "	}"
      echo "}"
    done
  } > "$cfnew"

  if cmp -s "$cfnew" "$cf" && [[ ! -e "$cfdirty" ]]; then
    rm -f "$cfnew"
  else
    mv "$cfnew" "$cf"
    if docker exec "$PROXY_NAME" caddy reload --config /etc/caddy/Caddyfile >/dev/null 2>&1; then
      rm -f "$cfdirty"
    else
      # Конфиг не принят — прокси работает на старом. Ставим метку, чтобы
      # следующий тик попробовал снова, и не переключаем serve вслепую:
      # ниже цель выбирается по тому, слушает ли теневой порт на самом деле.
      : > "$cfdirty"
      echo "ports-web: vps-proxy не принял конфиг (docker logs $PROXY_NAME)" >&2
    fi
  fi
fi

# --- 2) tailscale serve: по одному https-порту на веб-сервис (tailnet :P → :P)
# Номер порта в tailnet всегда равен номеру сервиса; меняется только ЦЕЛЬ:
# теневой порт прокси, если тот отвечает, иначе сам сервис напрямую. Спрашиваем
# у прокси его health-точку, а не просто «слушает ли порт»: конфиг мог не
# примениться, блок — оказаться не наш. Не ответил — сервис остаётся доступен
# напрямую, то есть худший исход поломки прокси это «медленно, как раньше».
proxy_ok(){ [[ "$(curl -s -m 2 "http://127.0.0.1:$1$PROXY_HEALTH" 2>/dev/null)" == "ok" ]]; }
declare -A want
for p in "${web_ports[@]}"; do
  sp=$(( p + PROXY_OFFSET ))
  if proxy_running; then
    # Свежий порт появляется в прокси через долю секунды после reload — ждём.
    for _try in 1 2 3 4 5; do proxy_ok "$sp" && break; sleep 0.4; done
  fi
  if proxy_ok "$sp"; then want[$p]="http://127.0.0.1:$sp"; else want[$p]="http://127.0.0.1:$p"; fi
done
want[$DASH_PORT]="static"            # дашборд отдаёт сам tailscaled из папки
want[443]="static"                   # и на главной https://<host>/ — без порта, одной закладкой
want[80]="static"                    # и по голому http://<host>/: браузер, которому набрали имя без схемы, идёт сюда

# ports-web — единственный хозяин tailnet-serve: состав всегда приводится к
# желаемому (веб-сервисы + дашборд), любое лишнее снимается. Само-исцеляется и
# не «моргает»: в устоявшемся состоянии обе ветки — no-op (add/off не нужны).
serve_map(){ # "порт<TAB>цель", где цель — url прокси или "static" для папки
  tailscale serve status --json 2>/dev/null | jq -r '
    (.Web // {}) | to_entries[]
    | (.key | split(":") | last) as $p
    | (.value.Handlers["/"] // {}) as $h
    | "\($p)\t\($h.Proxy // "static")"' 2>/dev/null
}
serve_tgt(){ serve_map | awk -F'\t' -v p="$1" '$1==p{print $2; exit}'; }
# 80 — единственный порт без TLS: tailscale serve различает --http и --https.
serve_flag(){ if [[ "$1" == 80 ]]; then echo "--http=80"; else echo "--https=$1"; fi; }

# привести к желаемому. tailscale правит один конфиг, и пачка команд подряд
# ловит гонку (часть молча не применяется) — поэтому проверяем и ретраим.
for p in "${!want[@]}"; do
  tgt="${want[$p]}"
  [[ "$(serve_tgt "$p")" == "$tgt" ]] && continue
  arg="$tgt"; [[ "$tgt" == "static" ]] && arg="$STATE_DIR/"
  for _try in 1 2 3 4 5; do
    sudo -n tailscale serve --bg "$(serve_flag "$p")" "$arg" >/dev/null 2>&1
    sleep 0.4
    [[ "$(serve_tgt "$p")" == "$tgt" ]] && break
  done
done
# снять всё, чего в желаемом нет (ушедшие проекты, старые схемы)
while IFS=$'\t' read -r p _; do
  [[ -n "$p" && -z "${want[$p]:-}" ]] && sudo -n tailscale serve "$(serve_flag "$p")" off >/dev/null 2>&1
done < <(serve_map)

# --- 3) дашборд index.html --------------------------------------------------
esc(){ sed -e 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g; s/"/\&quot;/g'; }

# Значок карточки: у инфраструктуры — свой (INFRA_ICON), у сервисов проектов —
# по образу контейнера.
icon_for(){
  local p="$1" web="$2" group="$3"
  local img="${PORT_IMAGE[$p]:-}"
  if [[ -n "${INFRA_ICON[$p]:-}" ]]; then printf '%s' "${INFRA_ICON[$p]}"; return; fi
  case "${img,,}" in
    *postgres*)        printf '🐘'; return ;;
    *mysql*|*mariadb*) printf '🐬'; return ;;
    *mongo*)           printf '🍃'; return ;;
    *redis*|*valkey*)  printf '⚡'; return ;;
  esac
  if   [[ "$group" == "без реестра" ]]; then printf '❔'
  elif [[ "$web" == 1 ]];               then printf '🌐'
  else                                       printf '🗄'
  fi
}

