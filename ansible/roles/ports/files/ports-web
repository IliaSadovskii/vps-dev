      printf '  <div class="cardwrap"><a class="card" href="https://%s:%s%s" target="_blank" rel="noopener"><span class="icon">%s</span><span class="name">%s</span><span class="desc">%s</span><span class="port">%s</span></a>%s</div>\n' \
        "$dnsname" "$p" "${INFRA_PATH[$p]:-/}" "$eicon" "$ename" "$edesc" "$p" "$gear"
    else
      printf '  <div class="card int"><span class="icon">%s</span><span class="name">%s</span><span class="desc">%s</span><span class="port">%s</span></div>\n' \
        "$eicon" "$ename" "$edesc" "$p"
    fi
  done < <(ordered_rows)
  printf '</div></section>\n'
done <<<"$ordered"

