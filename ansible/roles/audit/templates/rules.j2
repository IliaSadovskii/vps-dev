# Управляется Ansible: roles/audit/templates/rules.j2
#
# Правила намеренно скупые. Полный набор из руководств по соответствию
# пишет мегабайты в час и тонет в шуме — читать его никто не будет.
# Здесь только то, на что смотрят при разборе: кто получил доступ,
# кто менял вход, кто трогал время и ядро, кто правил брандмауэр.
#
# На этой машине агенты работают с правами пользователя {{ base_deploy_user }} —
# то есть с доступом к докеру и sudo. Если что-то пойдёт не так, вопрос
# будет не «что за сайт открыт», а «кто и когда получил сюда доступ и что
# сделал со входом» — на него и отвечают эти правила.

# Сбросить прежние правила, чтобы прогон был повторяемым.
-D
# Очередь событий. 8192 хватает с запасом при таком наборе.
-b 8192
# Что делать при потере событий: 1 — записать в журнал ядра.
# Не 2: остановка системы из-за переполнения очереди — это авария,
# которую мы сами себе устроили.
-f 1

# --- Учётные записи ---
-w /etc/passwd -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k identity
-w /etc/sudoers.d/ -p wa -k identity

# --- Вход по SSH ---
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d/ -p wa -k sshd
-w /root/.ssh/authorized_keys -p wa -k access
-w /home/{{ base_deploy_user }}/.ssh/authorized_keys -p wa -k access

# --- Брандмауэр ---
# Своё, чего не было у боевого сервера: там правила для контейнеров живут
# в отдельной службе (listate-docker-edge), здесь же — прямо в after.rules
# и after6.rules ufw (см. роль firewall). Правка любого файла в /etc/ufw/ —
# это либо открытие порта наружу, либо наоборот; на закрытом со всех сторон
# сервере это самое чувствительное место после самого входа по SSH.
-w /etc/ufw/ -p wa -k firewall

# --- Время ---
# Сдвиг часов ломает разбор: события выстраиваются в неверном порядке,
# и восстановить последовательность потом невозможно.
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time

# --- Модули ядра ---
# Загрузка модуля — обычный способ закрепиться в системе после взлома.
-a always,exit -F arch=b64 -S init_module,delete_module,finit_module -k modules

# Правила НЕ делаем неизменяемыми (-e 2): тогда любая правка требует
# перезагрузки машины, и повторный прогон настройки перестаёт быть
# безопасным.
