class Handler(BaseHTTPRequestHandler):
    server_version = "orch-chains"

    def do_GET(self):  # noqa: N802 — имя задано BaseHTTPRequestHandler
        path = self.path.partition("?")[0].rstrip("/") or "/"
        if path == "/":
            self.reply(200, "text/html; charset=utf-8", PAGE.encode("utf-8"))
        elif path == "/api/chains":
            self.reply(200, "application/json; charset=utf-8",
                       json.dumps(picture(), ensure_ascii=False, indent=1).encode("utf-8"))
        elif path == "/healthz":
            self.reply(200, "text/plain; charset=utf-8", b"ok\n")
        else:
            self.reply(404, "text/plain; charset=utf-8", "нет такой страницы\n".encode("utf-8"))

    def do_POST(self):  # noqa: N802
        path = self.path.partition("?")[0].rstrip("/")
        if not self.same_origin():
            self.fail(403, "запрос пришёл с чужого адреса")
            return
        parts = path.strip("/").split("/")
        if len(parts) < 3 or parts[0] != "api" or parts[1] != "chains":
            self.fail(404, "нет такой страницы")
            return
        name = urllib.parse.unquote(parts[2])
        if name not in names():
            self.fail(404, f"цепочки {name} нет")
            return
        try:
            if len(parts) == 4 and parts[3] == "reset":
                reset(name)
            elif len(parts) == 3:
                save(name, self.body().get("steps") or [])
            else:
                self.fail(404, "нет такой страницы")
                return
        except ChainError as exc:
            # Линтер отказал — пользовательский файл не тронут, на странице
            # остаётся то, что владелец набрал.
            self.fail(400, str(exc))
            return
        except (OSError, KeyError, TypeError, ValueError) as exc:
            log(f"{name}: {exc!r}")
            self.fail(400, f"не сохранил: {exc}")
            return
        self.reply(200, "application/json; charset=utf-8",
                   json.dumps({"ok": True, "custom": is_custom(name)}, ensure_ascii=False).encode("utf-8"))

    def body(self):
        length = int(self.headers.get("Content-Length") or 0)
        if not length:
            return {}
        return json.loads(self.rfile.read(length).decode("utf-8", "replace"))

    def same_origin(self):
        host = (self.headers.get("Host") or "").lower()
        src = self.headers.get("Origin") or self.headers.get("Referer") or ""
        if not host or not src:
            return False
        return (urllib.parse.urlsplit(src).netloc or "").lower() == host

    def fail(self, code, text):
        self.reply(code, "application/json; charset=utf-8",
                   json.dumps({"error": text}, ensure_ascii=False).encode("utf-8"))

    def reply(self, code, ctype, body):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(body)
        except BrokenPipeError:
            pass

    def log_message(self, fmt, *args):
        pass


def main():
    user_chains_dir().mkdir(parents=True, exist_ok=True)
    # Только loopback: в частную сеть отдаёт ports-web с TLS на том же порту.
    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    log(f"слушаю 127.0.0.1:{PORT}; заводские цепочки {chains_dir()}, правленые {user_chains_dir()}")
    server.serve_forever()


if __name__ == "__main__":
    main()
