#!/usr/bin/env python3
"""Локальный API закладок, который вызывает статический дашборд на :8062."""

from __future__ import annotations

import json
import os
import subprocess
import tempfile
import threading
import uuid
from http import HTTPStatus
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse


PORT = int(os.environ.get("BOOKMARKS_PORT", "8074"))
STATE_FILE = Path(os.environ.get("BOOKMARKS_FILE", "/var/lib/vps-dev/bookmarks/project-bookmarks.json"))
PROJECTS_DIR = Path(os.environ.get("BOOKMARKS_PROJECTS_DIR", "/projects")).resolve()
MAX_BODY = 32 * 1024
STATE_LOCK = threading.Lock()
DASHBOARD_ORIGIN = os.environ.get("BOOKMARKS_DASHBOARD_ORIGIN", "")


def project_path(value: object) -> str:
    if not isinstance(value, str):
        raise ValueError("проект не указан")
    path = Path(value).resolve()
    # Принимаем только главный checkout непосредственно в /projects. У worktree
    # .git — файл, а не каталог, поэтому он не получит собственную секцию.
    if path.parent != PROJECTS_DIR or not (path / ".git").is_dir():
        raise ValueError("это не главный проект в /projects")
    return str(path)


def text(value: object, field: str, limit: int, required: bool = True) -> str:
    if not isinstance(value, str):
        raise ValueError(f"{field}: нужен текст")
    value = value.strip()
    if required and not value:
        raise ValueError(f"{field}: не пустое")
    if len(value) > limit:
        raise ValueError(f"{field}: не длиннее {limit} символов")
    return value


def link_url(value: object) -> str:
    value = text(value, "адрес", 2048)
    parsed = urlparse(value)
    # В первую версию намеренно только браузерные адреса: это исключает
    # javascript: и другие схемы, которые превратили бы закладку в XSS.
    if parsed.scheme not in {"https", "http"} or not parsed.netloc:
        raise ValueError("адрес начинается с http:// или https://")
    return value


def read_state() -> dict:
    try:
        data = json.loads(STATE_FILE.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {"version": 1, "bookmarks": {}}
    except (OSError, json.JSONDecodeError):
        # Не затираем повреждённый файл следующей записью: его надо сначала
        # достать из бэкапа, а дашборд должен сообщить о проблеме.
        raise ValueError("файл закладок повреждён")
    if not isinstance(data, dict) or not isinstance(data.get("bookmarks"), dict):
        raise ValueError("файл закладок имеет неверный формат")
    # Версия с одними закладками уже могла появиться на машине до настройки
    # списка проектов. Новое поле добавляется лениво, без миграции файла.
    if not isinstance(data.get("projects", []), list):
        raise ValueError("список проектов имеет неверный формат")
    return data


def write_state(data: dict) -> None:
    STATE_FILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(prefix=".project-bookmarks.", dir=STATE_FILE.parent)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as stream:
            json.dump(data, stream, ensure_ascii=False, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, STATE_FILE)
    except Exception:
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass
        raise


def normal_bookmarks(items: object) -> list[dict]:
    if not isinstance(items, list):
        return []
    # Старый либо вручную сломанный объект не отдаем в HTML. Валидация записи
    # остаётся строгой; эта ветка даёт пользователю возможность удалить мусор.
    out = []
    for item in items:
        if isinstance(item, dict) and all(isinstance(item.get(key), str) for key in ("id", "label", "url", "tag")):
            out.append({key: item[key] for key in ("id", "label", "url", "tag")})
    return out


def normal_projects(items: object) -> list[str]:
    if not isinstance(items, list):
        return []
    return [item for item in items if isinstance(item, str)]


def dashboard_origin() -> str:
    """Точный Origin дашборда, не Host после Tailscale reverse proxy."""
    global DASHBOARD_ORIGIN
    if DASHBOARD_ORIGIN:
        return DASHBOARD_ORIGIN
    try:
        raw = subprocess.run(
            ["tailscale", "status", "--json"], capture_output=True, text=True, timeout=3, check=True
        ).stdout
        dns_name = str(json.loads(raw).get("Self", {}).get("DNSName", "")).rstrip(".")
        if dns_name:
            DASHBOARD_ORIGIN = f"https://{dns_name}:8062"
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError):
        pass
    return DASHBOARD_ORIGIN


class Handler(BaseHTTPRequestHandler):
    server_version = "vps-dev-bookmarks"

    def log_message(self, fmt: str, *args: object) -> None:
        print("bookmarks: " + fmt % args, flush=True)

    def cors(self) -> None:
        origin = self.headers.get("Origin", "")
        if self.from_dashboard():
            self.send_header("Access-Control-Allow-Origin", origin)
            self.send_header("Vary", "Origin")

    def from_dashboard(self) -> bool:
        # Tailscale передаёт API уже с локальным Host, поэтому сравнивать его
        # с Origin нельзя. Имя берём у tailscaled: это именно эта машина, а
        # не произвольная страница :8062 в общей tailnet.
        return self.headers.get("Origin", "") == dashboard_origin()

    def reply(self, status: HTTPStatus, body: dict) -> None:
        raw = json.dumps(body, ensure_ascii=False).encode("utf-8")
        self.send_response(status)
        self.cors()
        self.send_header("Content-Type", "application/json; charset=utf-8")
        self.send_header("Content-Length", str(len(raw)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(raw)

    def do_OPTIONS(self) -> None:
        self.send_response(HTTPStatus.NO_CONTENT)
        self.cors()
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.send_header("Access-Control-Max-Age", "600")
        self.end_headers()

    def do_GET(self) -> None:
        if self.path != "/api/bookmarks":
            self.reply(HTTPStatus.NOT_FOUND, {"error": "не найдено"})
            return
        try:
            state = read_state()
            safe = {path: normal_bookmarks(items) for path, items in state["bookmarks"].items()}
            self.reply(HTTPStatus.OK, {"bookmarks": safe, "projects": normal_projects(state.get("projects", []))})
        except ValueError as error:
            self.reply(HTTPStatus.INTERNAL_SERVER_ERROR, {"error": str(error)})

    def do_POST(self) -> None:
        if self.path != "/api/bookmarks":
            self.reply(HTTPStatus.NOT_FOUND, {"error": "не найдено"})
            return
        # CORS сам по себе не защищает от простого cross-site POST: браузер
        # может послать его и без права прочитать ответ. Запись разрешена
        # только странице дашборда на соседнем tailnet-порту.
        if not self.from_dashboard():
            self.reply(HTTPStatus.FORBIDDEN, {"error": "сохранять можно только с дашборда"})
            return
        try:
            size = int(self.headers.get("Content-Length", "0"))
            if not 0 < size <= MAX_BODY:
                raise ValueError("слишком большой запрос")
            payload = json.loads(self.rfile.read(size))
            if not isinstance(payload, dict):
                raise ValueError("нужен объект")
            action = payload.get("action")
            # ThreadingHTTPServer обслуживает параллельные клики. Без замка
            # два «Добавить» могли оба прочитать старый файл, и последний
            # молча затёр бы ссылку первого.
            with STATE_LOCK:
                state = read_state()

                if action == "save":
                    project = project_path(payload.get("project"))
                    items = normal_bookmarks(state["bookmarks"].get(project, []))
                    label = text(payload.get("label"), "название", 120)
                    url = link_url(payload.get("url"))
                    tag = text(payload.get("tag", ""), "тег", 64, required=False)
                    item_id = payload.get("id")
                    if item_id:
                        item_id = text(item_id, "идентификатор", 64)
                        for item in items:
                            if item["id"] == item_id:
                                item.update(label=label, url=url, tag=tag)
                                break
                        else:
                            raise ValueError("закладка уже удалена")
                    else:
                        items.append({"id": uuid.uuid4().hex, "label": label, "url": url, "tag": tag})
                elif action == "delete":
                    project = project_path(payload.get("project"))
                    items = normal_bookmarks(state["bookmarks"].get(project, []))
                    item_id = text(payload.get("id"), "идентификатор", 64)
                    changed = [item for item in items if item["id"] != item_id]
                    if len(changed) == len(items):
                        raise ValueError("закладка уже удалена")
                    items = changed
                elif action == "projects":
                    requested = payload.get("projects")
                    if not isinstance(requested, list) or len(requested) > 200:
                        raise ValueError("нужен список не длиннее 200 проектов")
                    selected = []
                    for value in requested:
                        path = project_path(value)
                        if path not in selected:
                            selected.append(path)
                    state["projects"] = selected
                    write_state(state)
                    self.reply(HTTPStatus.OK, {"projects": selected})
                    return
                else:
                    raise ValueError("неизвестное действие")

                state["bookmarks"][project] = items
                write_state(state)
            self.reply(HTTPStatus.OK, {"bookmarks": items})
        except (ValueError, json.JSONDecodeError) as error:
            self.reply(HTTPStatus.BAD_REQUEST, {"error": str(error)})
        except OSError as error:
            self.reply(HTTPStatus.INTERNAL_SERVER_ERROR, {"error": f"не записано: {error}"})


if __name__ == "__main__":
    ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
