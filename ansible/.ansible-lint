# Настройка ansible-lint.
#
# Профиль production, а не умолчание: код разворачивает машину целиком,
# и цена молчаливой ошибки здесь выше цены лишней придирки.

profile: production

# Чужие роли из Galaxy не наши, чтобы их чинить. Они приезжают в образ
# при сборке (см. runner/Dockerfile) и линтуются вместе с нашим кодом,
# заваливая вывод: у artis3n.tailscale только переменных без префикса
# роли — под тридцать штук. Свои замечания в этом шуме не разглядеть.
exclude_paths:
  - /usr/share/ansible/

skip_list:
  # Переменные без префикса роли. У нас это осознанно и в двух случаях:
  #
  #   base_deploy_user, ntfy_topic — общие для нескольких ролей. Префикс
  #   роли-владельца сделал бы их чтение в соседней роли странным
  #   (`ntfy_ntfy_topic`), а смысл у них ровно один на весь сценарий.
  #
  #   docker_* — переменные чужой роли geerlingguy.docker. Переименовать
  #   их нельзя: она читает свои имена.
  - var-naming[no-role-prefix]
