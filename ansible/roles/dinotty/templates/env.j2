# Управляется Ansible: roles/dinotty/templates/env.j2
#
# Пакетный юнит читает этот файл ПОСЛЕ своих Environment=, поэтому здесь
# и переопределяется порт: в самом юните зашит 8999.

# Не 8999 и не {{ dinotty_port }} — почему именно так, см. roles/dinotty/defaults.
DINOTTY_PORT={{ dinotty_internal_port }}

# Оболочка новых сессий. У системного пользователя, под которым служба
# работает из коробки, её нет; у нас пользователь настоящий, но пусть
# терминал не зависит от того, что записано в /etc/passwd.
SHELL=/bin/bash

RUST_LOG=info

# DINOTTY_TOKEN лежит не здесь, а в {{ dinotty_token_file }}: этот файл роль
# переписывает на каждом прогоне, а токен заводится однажды. Вводить его
# при входе не придётся — см. dinotty_ip_whitelist в defaults.
