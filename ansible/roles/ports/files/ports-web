    return element;
  };
  const shortHost = (value) => {
    try { return new URL(value).host; } catch (_) { return value; }
  };
  const setStatus = (panel, value) => {
    const status = panel.querySelector('.bookmark-status');
    if (status) status.textContent = value || '';
  };
  const request = async (body) => {
    const response = await fetch(api, {
      method: body ? 'POST' : 'GET',
      headers: body ? {'Content-Type': 'application/json'} : {},
      body: body ? JSON.stringify(body) : undefined,
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(payload.error || 'сервис закладок не ответил');
    return payload;
  };
  const selectTab = (name) => {
    document.querySelectorAll('.tab').forEach((button) => {
      const selected = button.dataset.tab === name;
      button.setAttribute('aria-selected', String(selected));
    });
    document.querySelector('#infra-panel').hidden = name !== 'infra';
    document.querySelector('#projects-panel').hidden = name !== 'projects';
  };
  const applyProjects = () => {
    if (!projectsList) return;
    const selected = new Map(selectedProjects.map((path, index) => [path, index]));
    for (const panel of projectPanels) {
      panel.hidden = panel.dataset.active !== '1' && !selected.has(panel.dataset.project);
    }
    [...projectPanels]
      .sort((left, right) => {
        const leftRank = selected.get(left.dataset.project);
        const rightRank = selected.get(right.dataset.project);
        if (leftRank !== undefined || rightRank !== undefined) return (leftRank ?? Infinity) - (rightRank ?? Infinity);
        return left.querySelector('h2').textContent.localeCompare(right.querySelector('h2').textContent, 'ru');
      })
      .forEach((panel) => projectsList.append(panel));
  };
  const saveProjects = async (next) => {
    const status = projectConfig.querySelector('.bookmark-status');
    status.textContent = 'Сохраняю…';
    try {
      const result = await request({action: 'projects', projects: next});
      selectedProjects = result.projects || [];
      applyProjects(); renderProjectConfig();
    } catch (error) { status.textContent = error.message; }
  };
  const renderProjectConfig = () => {
    if (!projectConfig) return;
    projectConfig.replaceChildren();
    projectConfig.append(node('div', 'bookmark-tag', 'Показывать также, когда контейнеры выключены'));
    const selected = new Map(selectedProjects.map((path, index) => [path, index]));
    const ordered = [...projectPanels].sort((left, right) => {
      const leftRank = selected.get(left.dataset.project);
      const rightRank = selected.get(right.dataset.project);
      if (leftRank !== undefined || rightRank !== undefined) return (leftRank ?? Infinity) - (rightRank ?? Infinity);
      return left.querySelector('h2').textContent.localeCompare(right.querySelector('h2').textContent, 'ru');
    });
    for (const panel of ordered) {
      const path = panel.dataset.project;
      const isSelected = selected.has(path);
      const row = node('div', 'project-choice');
      const checkbox = node('input'); checkbox.type = 'checkbox'; checkbox.checked = isSelected;
      checkbox.setAttribute('aria-label', `Показывать ${panel.querySelector('h2').textContent}`);
      const label = node('label', '', panel.querySelector('h2').textContent);
      if (panel.dataset.active === '1') label.append(node('small', '', ' · запущен'));
      checkbox.addEventListener('change', () => {
        const next = selectedProjects.filter((item) => item !== path);
        if (checkbox.checked) next.push(path);
        saveProjects(next);
      });
      const up = node('button', '', '↑'); up.type = 'button'; up.title = 'Выше'; up.disabled = !isSelected || selected.get(path) === 0;
      const down = node('button', '', '↓'); down.type = 'button'; down.title = 'Ниже'; down.disabled = !isSelected || selected.get(path) === selectedProjects.length - 1;
      up.addEventListener('click', () => {
        const index = selectedProjects.indexOf(path); const next = [...selectedProjects];
        [next[index - 1], next[index]] = [next[index], next[index - 1]]; saveProjects(next);
      });
      down.addEventListener('click', () => {
        const index = selectedProjects.indexOf(path); const next = [...selectedProjects];
        [next[index], next[index + 1]] = [next[index + 1], next[index]]; saveProjects(next);
      });
      row.append(checkbox, label, up, down); projectConfig.append(row);
    }
    projectConfig.append(node('div', 'bookmark-status'));
  };
  const render = (panel) => {
    const project = panel.dataset.project;
    const items = all[project] || [];
    panel.replaceChildren();
    const groups = new Map();
    for (const item of items) {
      const tag = item.tag || '';
      if (!groups.has(tag)) groups.set(tag, []);
      groups.get(tag).push(item);
    }
    const grid = node('div', 'bookmark-groups');
    [...groups.entries()]
      .sort(([left], [right]) => (left || '\uffff').localeCompare(right || '\uffff', 'ru'))
      .forEach(([tag, group]) => {
        const block = node('div', 'bookmark-group');
        block.append(node('div', 'bookmark-tag', tag || 'Без тега'));
        for (const item of group) {
          const line = node('div', 'bookmark-line');
          const link = node('a', 'bookmark-link');
          link.href = item.url; link.target = '_blank'; link.rel = 'noopener';
          link.append(node('span', '', item.label), node('span', 'bookmark-host', shortHost(item.url)));
          const tools = node('span', 'bookmark-tools');
          const edit = node('button', '', '✎'); edit.type = 'button'; edit.title = 'Изменить'; edit.setAttribute('aria-label', 'Изменить');
          edit.addEventListener('click', () => fillForm(panel, item));
          const remove = node('button', '', '×'); remove.type = 'button'; remove.title = 'Удалить'; remove.setAttribute('aria-label', 'Удалить');
          remove.addEventListener('click', async () => {
            if (!confirm(`Удалить «${item.label}»?`)) return;
            try {
              const result = await request({action: 'delete', project, id: item.id});
              all[project] = result.bookmarks; render(panel);
            } catch (error) { setStatus(panel, error.message); }
          });
          tools.append(edit, remove); line.append(link, tools); block.append(line);
        }
        grid.append(block);
      });
    if (!items.length) grid.append(node('div', 'bookmark-empty', 'Пока нет закладок.'));
    const head = node('div', 'bookmark-panel-head');
    head.append(node('strong', '', 'Закладки'));
    const add = node('button', 'bookmark-add', '＋'); add.type = 'button'; add.title = 'Добавить закладку'; add.setAttribute('aria-label', 'Добавить закладку');
    const formWrap = node('div', 'bookmark-form-wrap'); formWrap.hidden = true;
    formWrap.append(form(panel));
    add.addEventListener('click', () => {
      formWrap.hidden = !formWrap.hidden;
      if (!formWrap.hidden) formWrap.querySelector('[name=label]').focus();
    });
    head.append(add); panel.append(head, grid, formWrap);
  };
  const fillForm = (panel, item) => {
    const current = panel.querySelector('.bookmark-form');
    current.elements.id.value = item.id;
    current.elements.label.value = item.label;
    current.elements.url.value = item.url;
    current.elements.tag.value = item.tag;
    current.querySelector('[type=submit]').textContent = 'Сохранить';
    current.querySelector('[type=button]').hidden = false;
    current.closest('.bookmark-form-wrap').hidden = false;
    current.querySelector('[name=label]').focus();
  };
  const form = (panel) => {
    const project = panel.dataset.project;
    const element = node('form', 'bookmark-form');
    element.noValidate = true;
    const hidden = node('input'); hidden.name = 'id'; hidden.type = 'hidden';
    const label = node('input'); label.name = 'label'; label.placeholder = 'Название'; label.setAttribute('aria-label', 'Название'); label.required = true;
    const url = node('input'); url.name = 'url'; url.placeholder = 'https://…'; url.setAttribute('aria-label', 'Адрес'); url.required = true;
    const tag = node('input'); tag.name = 'tag'; tag.placeholder = 'Тег'; tag.setAttribute('aria-label', 'Тег');
    const save = node('button', 'bookmark-action', 'Добавить'); save.type = 'submit';
    const cancel = node('button', 'bookmark-action', 'Отмена'); cancel.type = 'button'; cancel.hidden = true;
    const status = node('div', 'bookmark-status');
    cancel.addEventListener('click', () => render(panel));
    element.addEventListener('input', () => { cancel.hidden = !element.elements.id.value; });
    element.addEventListener('submit', async (event) => {
      event.preventDefault();
      setStatus(panel, 'Сохраняю…');
      try {
        const data = new FormData(element);
        const result = await request({
          action: 'save', project, id: data.get('id'), label: data.get('label'),
          url: data.get('url'), tag: data.get('tag'),
        });
        all[project] = result.bookmarks; render(panel);
      } catch (error) { setStatus(panel, error.message); }
    });
    element.append(hidden, label, url, tag, save, cancel, status);
    return element;
  };
  document.querySelectorAll('.bookmark-toggle').forEach((button) => {
    const section = button.closest('section');
    const panel = section.querySelector('.bookmark-panel');
    const rows = section.querySelector('.rows');
    const empty = section.querySelector('.empty-project');
    button.addEventListener('click', () => {
      const bookmarks = panel.hidden;
      panel.hidden = !bookmarks;
      rows.hidden = bookmarks;
      if (empty) empty.hidden = bookmarks;
      button.textContent = bookmarks ? '▦ Контейнеры' : '☆ Закладки';
      button.setAttribute('aria-expanded', String(bookmarks));
    });
  });
  document.querySelectorAll('.tab').forEach((button) => {
    button.addEventListener('click', () => selectTab(button.dataset.tab));
  });
  const projectConfigToggle = document.querySelector('#project-config-toggle');
  if (projectConfigToggle) projectConfigToggle.addEventListener('click', () => {
    selectTab('projects');
    projectConfig.hidden = !projectConfig.hidden;
    projectConfigToggle.setAttribute('aria-expanded', String(!projectConfig.hidden));
  });
  request().then((payload) => {
    all = payload.bookmarks || {};
    selectedProjects = payload.projects || [];
    applyProjects(); renderProjectConfig();
    panels.forEach(render);
  }).catch((error) => panels.forEach((panel) => {
    panel.replaceChildren(node('div', 'bookmark-status', `Закладки недоступны: ${error.message}`));
  }));
})();
</script>
