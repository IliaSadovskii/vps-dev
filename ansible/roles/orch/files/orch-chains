def log(msg):
    print(f"orch-chains: {msg}", flush=True)


# ------------------------------------------------------- что предлагаем --

def catalog_options():
    """Модели и усилия по агентам — из каталога AoE, иначе запасные."""
    models = {a: list(FALLBACK_MODELS.get(a, [])) for a in VALID_AGENTS}
    efforts = {a: list(FALLBACK_EFFORTS) for a in VALID_AGENTS}
    try:
        with open(CATALOG_FILE, encoding="utf-8") as f:
            raw = json.load(f)
    except (OSError, json.JSONDecodeError) as exc:
        log(f"каталог моделей не прочитан ({exc}) — показываю запасной список")
        return models, efforts
    for agent, body in (raw.get("agents") or {}).items():
        if agent not in models:
            continue
        for option in body.get("options") or []:
            values = [o.get("value") for o in (option.get("options") or []) if o.get("value")]
            # У claude «default» в списке моделей — это «как в настройках
            # хоста»; цепочка называет модель явно, поэтому такой выбор
            # здесь означал бы «неизвестно что» и не предлагается.
            values = [v for v in values if v != "default"]
            if not values:
                continue
            if option.get("id") == "model":
                models[agent] = values
            elif option.get("id") in ("effort", "reasoning_effort"):
                efforts[agent] = values
    return models, efforts


# ---------------------------------------------------------- чтение YAML --

def header_comment(path):
    """Первый абзац шапки файла — описание цепочки одной мыслью.

    Дальше в шапке идут подробности для того, кто правит файл руками
    (формат, откуда роли, почему такая модель); на странице они заняли бы
    пол-экрана и оттеснили сами шаги.
    """
    out = []
    try:
        for line in path.read_text(encoding="utf-8").splitlines():
            if not line.startswith("#"):
                break
            body = line.lstrip("#").strip()
            if not body:            # пустая строка комментария — конец абзаца
                break
            out.append(body)
    except OSError:
        return []
    return out


def factory_raw(name):
    path = chains_dir() / f"{name}.yml"
    return yaml.safe_load(path.read_text(encoding="utf-8")), path


def step_view(step):
    """Шаг для страницы: что правим — полями, что показываем — текстом."""
    next_map = step.next
    return {
        "id": step.id,
        "agent": step.agent,
        "model": step.model,
        "effort": step.effort or "",
        "context": step.context,
        "ask": step.human_ask,
        "after": step.human_after,
        "max_runs": step.max_runs,
        # Дальше — только для чтения: в первой версии правятся параметры и
        # порядок, а переходы, артефакты и роль остаются как в репозитории.
        "outcomes": [o for o in next_map if o != "*"],
        "next": next_map,
        "artifact": step.artifact,
        "reads": step.reads,
        "prompt_file": step.prompt_file,
        "moves": step.human_moves,
        "includes": step.includes,
        "instructions": bool(step.instructions),
    }


def chain_view(name):
    path = path_of(name)
    custom = is_custom(name)
    view = {
        "name": name,
        "custom": custom,
        "description": " ".join(header_comment(chains_dir() / f"{name}.yml")).strip(),
        "path": str(path),
        "factory_only": not (chains_dir() / f"{name}.yml").exists(),
    }
    try:
        chain = load(path)
    except ChainError as exc:
        view["error"] = str(exc)
        view["steps"] = []
        return view
    view["steps"] = [step_view(s) for s in chain.steps]
    return view


# Порядок на странице — заданный, а не по алфавиту: сверху та цепочка, по
# которой едет обычная работа, служебная проверка механики — в конце.
CHAIN_ORDER = ["deep", "conventions", "blueprint", "smoke"]


def ordered_names():
    known = names()
    first = [n for n in CHAIN_ORDER if n in known]
    return first + [n for n in known if n not in first]


def picture():
    models, efforts = catalog_options()
    return {
        "chains": [chain_view(n) for n in ordered_names()],
        "options": {
            "agents": list(VALID_AGENTS),
            "models": models,
            "efforts": efforts,
            "contexts": [{"value": c, "label": CONTEXT_TEXT.get(c, c)} for c in VALID_CONTEXT],
        },
        "user_dir": str(user_chains_dir()),
        "dashboard": DASHBOARD,
    }


# ----------------------------------------------------------- сохранение --

def apply_edits(name, edits):
    """Наложить правки страницы на заводскую цепочку и вернуть текст YAML.

    Основа всегда заводская: страница правит порядок шагов и параметры
    внутри шага, остальное берётся из репозитория (см. шапку файла).
    """
    raw, path = factory_raw(name)
    by_id = {s.get("id"): s for s in (raw.get("steps") or [])}
    order = [e.get("id") for e in edits]
    if sorted(order) != sorted(by_id):
        raise ChainError(
            "список шагов не совпал с заводским: перезагрузите страницу — "
            "цепочка в репозитории изменилась"
        )

    steps = []
    for edit in edits:
        step = dict(by_id[edit["id"]])
        run = dict(step.get("run") or {})
        run["agent"] = edit["agent"]
        run["model"] = edit["model"]
        if edit.get("effort"):
            run["effort"] = edit["effort"]
        else:
            run.pop("effort", None)
        step["run"] = run

        step["context"] = edit["context"]

        human = dict(step.get("human") or {})
        after = edit.get("after", False)
        if after is False:
            human.pop("after", None)
            # Линтер: кнопки возврата без ворот не появятся, потому что
            # задача на шаге не остановится. Убираем вместе с воротами и
            # говорим об этом на странице.
            human.pop("moves", None)
        else:
            human["after"] = after
        human["ask"] = bool(edit.get("ask"))
        if human:
            step["human"] = human
        else:
            step.pop("human", None)

        limits = dict(step.get("limits") or {})
        runs = int(edit.get("max_runs") or 1)
        if runs < 1 or runs > 20:
            raise ChainError(f"шаг {edit['id']}: заходов {runs}, а надо от 1 до 20")
        limits["max_runs"] = runs
        step["limits"] = limits
        steps.append(step)

    raw["steps"] = steps
    body = yaml.safe_dump(
        raw, sort_keys=False, allow_unicode=True, default_flow_style=False, width=100
    )
    head = [
        f"# Цепочка {name}, правленная владельцем на странице настроек.",
        "#",
        "# Файл создан страницей orch-chains и ею же удаляется кнопкой",
        "# «Сбросить до заводских». Заводская версия со всеми объяснениями —",
        f"# {path}",
        "# Правьте заводскую в репозитории, а не этот файл: следующее сохранение",
        "# на странице соберёт его заново из заводского.",
        "",
    ]
    text = "\n".join(head) + body
    parse(text, source=f"{name} (правленая)")   # линтер: не сохраняем битое
    return text


def save(name, edits):
    text = apply_edits(name, edits)
    target = user_chains_dir() / f"{name}.yml"
    target.parent.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(".yml.new")
    tmp.write_text(text, encoding="utf-8")
    os.replace(tmp, target)
    log(f"{name}: сохранена пользовательская версия")


def reset(name):
    target = user_chains_dir() / f"{name}.yml"
    try:
        target.unlink()
        log(f"{name}: пользовательская версия удалена, цепочка снова заводская")
    except FileNotFoundError:
        pass


