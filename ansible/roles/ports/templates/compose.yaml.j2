# Управляется Ansible: roles/ports/templates/compose.yaml.j2
# Правки здесь переживут ровно до следующей выкатки.
#
# Прокси проектов: Tailscale терминирует TLS, но отдаёт байт-в-байт — ни
# сжатия, ни кэширующих заголовков. Дев-серверы приложений (какой бы стек
# их ни поднял) тоже обычно молчат про Cache-Control, поэтому браузер тянет
# всю статику заново на каждой перезагрузке. Один прокси перед всеми
# проектами чинит это разом и НЕ ТРОГАЕТ РЕПОЗИТОРИИ: платформа даёт
# способность, проекту ничего объявлять не нужно.
#
# СХЕМА. Проект как слушал свой порт 80XY на 127.0.0.1, так и слушает.
# Прокси слушает ТЕНЕВОЙ порт (80XY + 1000 = 90XY) и ходит на 80XY. В tailnet
# ports-web отдаёт сервис на прежнем номере 80XY, но целью ставит теневой:
#
#   tailnet :8050 ──► 127.0.0.1:9050 (vps-proxy) ──► 127.0.0.1:8050 (проект)
#
# Номера портов, которыми пользуется человек и `ports map`, не меняются;
# 90xx — внутренняя кухня, наружу не торчит и в реестр не попадает.
#
# Сеть — host: иначе на каждый новый проект пришлось бы пересоздавать
# контейнер ради -p. Слушает при этом только 127.0.0.1 — это задаёт сам
# Caddyfile (bind 127.0.0.1 в каждом блоке), а не эта сеть; host-сеть
# только избавляет от необходимости публиковать порты явно.
#
# Полную раскладку (по одному блоку на веб-сервис) пишет ports-web — он
# один знает, какие сервисы сейчас живы. Роль кладёт только заготовку,
# чтобы контейнеру было с чем стартовать до первого прогона таймера
# (см. files/Caddyfile и задачу «Заготовка конфига прокси»).

name: vps-proxy

services:
  caddy:
    image: {{ ports_proxy_image }}
    container_name: {{ ports_proxy_container }}
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ ports_proxy_dir }}:/etc/caddy
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
