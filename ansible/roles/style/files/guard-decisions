              "кавычки сам, и сторож не знает, куда ляжет правка. Скопируй old_string из файла точно.")


def main():
    raw = sys.stdin.buffer.read()
    if b'"agent_id"' not in raw:
        return
    hook = json.loads(raw)
    agent_id = hook.get("agent_id")
    if not isinstance(agent_id, str) or not agent_id:
        return
    if not all(ch.isascii() and (ch.isalnum() or ch in "_-") for ch in agent_id):
        return
    tool = hook.get("tool_name")
    args = hook.get("tool_input") or {}
    cwd = hook.get("cwd") if isinstance(hook.get("cwd"), str) and hook.get("cwd") else os.getcwd()
    roots = journal_roots(hook)
    grant = None  # разрешение читается лениво: только когда дошло до запрета

    def granted(word):
        nonlocal grant
        if grant is None:
            grant = allowed(hook) if isinstance(hook.get("transcript_path"), str) else set()
        return word in grant

    def in_journals(path):
        # Журналы и meta — да; автопамять <проект>/memory/ — нет: разрешение оттуда не читается.
        for r in roots:
            if path == r or path.startswith(r + "/"):
                parts = path[len(r) + 1:].split("/")
                return not (len(parts) > 2 and parts[1] == "memory")
        return False

    def guard_path(path, how):
        if in_journals(path):
            deny(f"{how}{path} {JOURNALS}")
        if ARCH_PATH.search(path):
            if existing(path):
                deny(f"{how}{path} {ARCH_OLD}")
            if not granted(ARCH):
                deny(f"{how}{path} {ARCH_NEW}")

    if tool == "Bash":
        cmd = args.get("command") or ""
        if not isinstance(cmd, str):
            return
        paths = written(cmd, cwd)
        for path in paths:
            guard_path(path, "команда оболочки пишет в ")
        for path in paths:
            if is_plan(path) and not granted(DECISIONS):
                deny(f"команда оболочки пишет в {path} {PLAN_BASH}")
        return

    path = args.get("file_path") or args.get("notebook_path") or ""
    if not isinstance(path, str) or not path:
        return
    path = real(path, cwd)
    guard_path(path, "")
    if ARCH_PATH.search(path) or not is_plan(path):
        return
    try:
        with open(path, encoding="utf-8") as fh:
            before = fh.read()
    except FileNotFoundError:
        before = ""
    if tool == "Write":
        after = args.get("content")
    elif tool == "Edit":
        after = after_edits(before, [args])
    elif tool == "MultiEdit":
        after = after_edits(before, args.get("edits") or [])
    else:
        return
    if after is None:
        edits = [args] if tool == "Edit" else args.get("edits") or []
        adds = any(SECTION.match(line) for e in edits for line in str(e.get("new_string") or "").splitlines())
        if (decisions(before) or adds) and not granted(DECISIONS):
            deny(PLAN_FUZZY.format(path))
        return
    if not isinstance(after, str):
        return
    if decisions(before) != decisions(after) and not granted(DECISIONS):
        deny(PLAN_EDIT.format(path))


if __name__ == "__main__":
    try:
        main()
    except SystemExit:
        raise
    except Exception:  # noqa: BLE001 — хук не должен ломать работу агента
        pass
    sys.exit(0)
