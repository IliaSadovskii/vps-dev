# К живым группам добавляем каталоги главных репозиториев, поэтому выключенный
# проект не исчезает вместе с последним контейнером.
groups="$( { cut -d$'\x1f' -f2 <<<"$rows"; printf '%s\n' "${!PROJECT_PATH[@]}"; } | sed '/^$/d' | sort -u)"
ordered="$( { grep -x 'инфраструктура' <<<"$groups"; grep -x 'без реестра' <<<"$groups"; grep -vx 'инфраструктура' <<<"$groups" | grep -vx 'без реестра' | sort; } 2>/dev/null )"

projects_open=0
while IFS= read -r g; do
  [[ -n "$g" ]] || continue
  case "$g" in
    "инфраструктура") gclass=infra ;;
    "без реестра")    gclass=nores ;;
    *)                gclass=proj ;;
  esac
  if [[ "$gclass" == "proj" && "$projects_open" == 0 ]]; then
    printf '%s\n' '</div><div id="projects-panel" class="tab-panel" hidden><div id="project-config" class="project-config" hidden></div><div id="projects-list">'
    projects_open=1
  fi
  # Инфраструктура — карточками (их дюжина, они разные и нужны глазами),
  # сервисы проекта — строками: их до десяти на проект, и десять карточек
  # вытесняли со страницы всё остальное.
  if [[ "$gclass" == "proj" ]]; then
