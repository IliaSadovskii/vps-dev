class Handler(BaseHTTPRequestHandler):
    server_version = "vps-dev-updates"

    def do_GET(self):  # noqa: N802 — имя задано BaseHTTPRequestHandler
        path, _, query = self.path.partition("?")
        path = path.rstrip("/") or "/"
        if path == "/":
            flash = ""
            if "queued=1" in query:
                flash = '<div class="flash">Задание принято. Журнал прогона появится ниже, страница обновляется сама.</div>'
            elif "reset=1" in query:
                flash = ('<div class="flash">Выбранные версии стёрты. Прогоните выкатку — машина вернётся '
                         'к тому, что записано в репозитории.</div>')
            self.reply(200, "text/html; charset=utf-8", render(picture(), flash).encode("utf-8"))
        elif path == "/api/updates":
            self.reply(200, "application/json; charset=utf-8",
                       json.dumps(picture(), ensure_ascii=False, indent=1).encode("utf-8"))
        elif path == "/healthz":
            self.reply(200, "text/plain; charset=utf-8", b"ok\n")
        else:
            self.reply(404, "text/plain; charset=utf-8", "нет такой страницы\n".encode("utf-8"))

    def do_POST(self):  # noqa: N802
        path = self.path.rstrip("/")
        if not self.same_origin():
            self.reply(403, "text/plain; charset=utf-8", "форма пришла с чужого адреса\n".encode("utf-8"))
            return
        length = int(self.headers.get("Content-Length") or 0)
        form = urllib.parse.parse_qs(self.rfile.read(length).decode("utf-8", "replace")) if length else {}
        if path == "/update":
            service = (form.get("service") or [""])[0]
            version = (form.get("version") or [""])[0]
            known = {s["id"] for s in read_json(SERVICES_FILE, [])}
            # Версия приходит из нашей же формы, но проверяем: в задании
            # она попадёт в файл, который читает Ansible.
            if service not in known or not re.fullmatch(r"[A-Za-z0-9._+-]{1,64}", version or ""):
                self.reply(400, "text/plain; charset=utf-8", "непонятное задание\n".encode("utf-8"))
                return
            enqueue({"action": "update", "service": service, "version": version})
            self.redirect("/?queued=1")
        elif path == "/reset":
            enqueue({"action": "reset"})
            self.redirect("/?reset=1")
        else:
            self.reply(404, "text/plain; charset=utf-8", "нет такой страницы\n".encode("utf-8"))

    def same_origin(self):
        host = (self.headers.get("Host") or "").lower()
        src = self.headers.get("Origin") or self.headers.get("Referer") or ""
        if not host or not src:
            return False
        return (urllib.parse.urlsplit(src).netloc or "").lower() == host

    def redirect(self, where):
        self.send_response(303)
        self.send_header("Location", where)
        self.send_header("Content-Length", "0")
        self.end_headers()

    def reply(self, code, ctype, body):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        try:
            self.wfile.write(body)
        except BrokenPipeError:
            pass

    def log_message(self, fmt, *args):
        pass


def main():
    os.makedirs(QUEUE_DIR, exist_ok=True)
    os.makedirs(LOG_DIR, exist_ok=True)
    threading.Thread(target=poll_loop, daemon=True).start()
    # Только loopback: в частную сеть отдаёт ports-web с TLS на том же порту.
    server = ThreadingHTTPServer(("127.0.0.1", PORT), Handler)
    log(f"слушаю 127.0.0.1:{PORT}, опрос источников раз в {POLL_SECONDS} с")
    server.serve_forever()


if __name__ == "__main__":
    main()
