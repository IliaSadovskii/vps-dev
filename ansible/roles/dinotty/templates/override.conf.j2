# Управляется Ansible: roles/dinotty/templates/override.conf.j2
#
# Пакет ставит службу под системным пользователем dinotty и в песочнице:
# корень только на чтение, /home только на чтение, повышение прав запрещено.
# Для «терминала-IDE» на чужой машине это разумно, здесь — не подходит.
#
# Это терминал пользователя {{ base_deploy_user }}: тот же $HOME, что у Kandev
# и aoe, то есть общий вход в CLI агентов — что залогинили здесь, увидят
# и доска, и чат. Из него ставят пакеты и правят системные файлы через sudo.
# Поэтому песочница снимается целиком и явно: ровно столько же прав, сколько
# было у ttyd, которого этот терминал заменил.

[Service]
User={{ base_deploy_user }}
Group={{ base_deploy_user }}
WorkingDirectory={{ dinotty_cwd }}

# Снятие песочницы пакета. Пустое значение — сброс списка целиком, а не
# добавление к нему.
ProtectSystem=no
ProtectHome=no
PrivateTmp=no
ReadWritePaths=
BindPaths=
# Без этого не работает sudo — то есть половина того, зачем открывают терминал.
NoNewPrivileges=no
