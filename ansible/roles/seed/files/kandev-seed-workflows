#!/usr/bin/env python3
# kandev-seed-workflows — цепочки шагов из файлов на доску Kandev, с
# обновлением на месте.
#
# Запускает роль seed при каждом прогоне. Руками звать не нужно.
#
# ЗАЧЕМ. Родной импорт Kandev аддитивен по имени: новую цепочку создаёт,
# занятое имя молча пропускает. Поэтому исправленную цепочку приходилось
# сначала удалять в интерфейсе. Этот скрипт делает то же, что родная
# синхронизация из GitHub (`workflow/service/sync_apply.go`), но из файлов
# репозитория: цепочку находит по имени, колонки — по именам внутри неё.
# Совпавшая колонка сохраняет свой идентификатор, и задачи, которые в ней
# стоят, никуда не деваются; новая создаётся; исчезнувшая удаляется, только
# если в ней нет задач — иначе цепочка не трогается и об этом сказано.
#
# ВХОД — JSON на stdin:
#   {"api": ".../api/v1", "workspace_id": "...",
#    "profiles": [{"agent": "claude-acp", "name": "Opus", ...}],
#    "prompts": {"custom-discovery": "<текст роли>", ...},
#    "files": [{"name": "deep.yml", "doc": {<разобранный YAML>}}]}
# Строки `@имя` в промптах колонок разворачиваются здесь в текст роли из
# `prompts` — см. expand_refs.
# YAML разбирает Ansible: на машине PyYAML может не быть, а у Ansible он
# есть всегда.
#
# ВЫХОД — JSON на stdout:
#   {"created": [...], "updated": [...], "unchanged": [...],
#    "warnings": [...]}
# Ненулевой код — только когда API не отвечает или отвечает ошибкой: это
# сбой прогона, а не состояние доски. Предупреждение — это состояние доски,
# которое требует руки человека (задачи в удалённой колонке, профиль агента,
# которого нет), и прогон из-за него не падает.
#
# ПРОФИЛИ. `profiles` из stdin (файл kandev/profiles.yml) заводятся или
# обновляются у агентов по паре (агент, имя); агента нет на машине —
# предупреждение. Колонка с `agent_profile` (тройка отображаемое имя
# агента / модель / режим, как в переносимом формате Kandev) получает id
# найденного профиля; не найден — предупреждение, профиль колонки не
# трогается. Так цепочка с моделями уезжает на машину без этих подписок и
# ничего не ломает.
#
# ПОРЯДОК НА ДОСКЕ. Необязательный ключ `sort_order` у цепочки в файле
# (не часть переносимого формата: перед импортом вырезается) задаёт, в
# каком порядке дорожки стоят на доске. После сверки всех файлов цепочки
# с ключом выстраиваются по нему, остальные — за ними в прежнем порядке,
# одним вызовом `PUT /workspaces/{ws}/workflows/reorder`.
#
# ЧЕГО НЕ ДЕЛАЕТ. Не удаляет цепочки и профили: файл пропал — на доске
# остаётся. Не трогает `stage_type` (в переносимом формате его нет).

import json
import re
import sys
import urllib.error
import urllib.request

TRIGGERS_WITH_TARGET = (
    "on_turn_start",
    "on_turn_complete",
    "on_comment",
    "on_blocker_resolved",
    "on_children_completed",
    "on_approval_resolved",
    "on_heartbeat",
    "on_budget_alert",
    "on_agent_error",
)

STEP_FIELDS = (
    "color",
    "prompt",
    "is_start_step",
    "show_in_command_panel",
    "allow_manual_move",
    "auto_archive_after_hours",
    "auto_advance_requires_signal",
    "cancel_triggers_turn_complete",
    "wip_limit",
)


class Api:
    def __init__(self, base):
        self.base = base.rstrip("/")
        self._interlock = None

    def interlock(self):
        """Токен для правки настроек агентов: Kandev требует его в заголовке
        и отдаёт в HTML главной страницы (per-boot CSRF-замок)."""
        if self._interlock is None:
            root = self.base[: -len("/api/v1")] if self.base.endswith("/api/v1") else self.base
            try:
                with urllib.request.urlopen(root + "/", timeout=30) as r:
                    html = r.read().decode(errors="replace")
            except (urllib.error.URLError, urllib.error.HTTPError) as e:
                raise SystemExit(f"GET {root}/: {e}")
            m = re.search(r'interimSettingsInterlockToken":"([^"]+)"', html)
            self._interlock = m.group(1) if m else ""
        return self._interlock

    def call(self, method, path, body=None, content_type="application/json", settings=False):
        data = None
        headers = {"Accept": "application/json"}
        if settings:
            headers["X-Kandev-Interim-Settings-Interlock"] = self.interlock()
        if body is not None:
            # JSON — подмножество YAML, поэтому импорт, ждущий YAML, читает
            # его как есть.
            data = json.dumps(body).encode()
            headers["Content-Type"] = content_type
        req = urllib.request.Request(
            self.base + path, data=data, method=method, headers=headers
        )
        try:
            with urllib.request.urlopen(req, timeout=30) as resp:
                raw = resp.read()
        except urllib.error.HTTPError as e:
            detail = e.read().decode(errors="replace")[:300]
            raise SystemExit(f"{method} {path}: HTTP {e.code}: {detail}")
        except urllib.error.URLError as e:
            raise SystemExit(f"{method} {path}: {e.reason}")
        return json.loads(raw) if raw else {}


def remap_events(events, key_from, key_to, lookup):
    """Переписать цели move_to_step: позиция ↔ идентификатор колонки."""
    out = {}
    for trigger, actions in (events or {}).items():
        new_actions = []
        for a in actions or []:
            a = dict(a)
            cfg = a.get("config")
            if (
                trigger in TRIGGERS_WITH_TARGET
                and a.get("type") == "move_to_step"
                and isinstance(cfg, dict)
                and key_from in cfg
            ):
                target = lookup(cfg[key_from])
                if target is None:
                    raise SystemExit(
                        f"move_to_step points at unknown {key_from} "
                        f"{cfg[key_from]!r}"
                    )
                cfg = {k: v for k, v in cfg.items() if k != key_from}
                cfg[key_to] = target
                a["config"] = cfg
            new_actions.append(a)
        if new_actions:
            out[trigger] = new_actions
    return out


def normalize(value):
    """Привести к виду, в котором пустое и отсутствующее — одно и то же."""
    if isinstance(value, dict):
        return {
            k: normalize(v)
            for k, v in value.items()
            if v not in (None, "", [], {}) and normalize(v) not in ([], {})
        }
    if isinstance(value, list):
        return [normalize(v) for v in value]
    return value


def coerce(field, value):
    """Одна и та же форма поля для доски и для файла."""
    if field == "prompt":
        # Kandev хранит промпт без завершающего перевода строки, а Ansible
        # lookup('file') его отбрасывает — сравниваем без хвостовых переводов.
        return (value or "").rstrip("\n")
    if field == "color":
        return value or ""
    if field in ("auto_archive_after_hours", "wip_limit"):
        return value
    return bool(value)


def portable_of_live(step, id_to_pos):
    """Колонка с доски в переносимом виде, чтобы сравнить с файлом."""
    p = {"name": step["name"], "position": step["position"],
         "profile_id": step.get("agent_profile_id") or ""}
    for f in STEP_FIELDS:
        p[f] = coerce(f, step.get(f))
    p["events"] = remap_events(
        step.get("events"), "step_id", "step_position", id_to_pos.get
    )
    pull = step.get("pull_from_step_id")
    if pull and pull in id_to_pos:
        p["pull_from_step_position"] = id_to_pos[pull]
    return normalize(p)


def portable_of_file(sp, live_profile_id=""):
    # Профиль сравнивается по id, который resolve_profile положил в
    # sp["_profile_id"]; не найден на машине — считаем, что как на доске.
    pid = sp.get("_profile_id")
    p = {"name": sp["name"], "position": sp["position"],
         "profile_id": pid if pid is not None else live_profile_id}
    for f in STEP_FIELDS:
        p[f] = coerce(f, sp.get(f))
    p["events"] = sp.get("events") or {}
    if sp.get("pull_from_step_position") is not None:
        p["pull_from_step_position"] = sp["pull_from_step_position"]
    return normalize(p)


def reconcile(api, wf, desired, result, lookup):
    name = desired["name"]
    warnings = result["warnings"]
    if desired.get("agent_profile"):
        warnings.append(
            f"{name}: профиль агента на уровне цепочки из файла не ставится"
        )

    live = api.call("GET", f"/workflows/{wf['id']}/workflow/steps")["steps"]
    live_by_name = {}
    for st in live:
        if st["name"] in live_by_name:
            warnings.append(
                f"{name}: на доске две колонки «{st['name']}», "
                "переименуйте одну — цепочка не обновлена"
            )
            return
        live_by_name[st["name"]] = st

    steps = desired.get("steps") or []
    wanted = {}
    for sp in steps:
        if sp["name"] in wanted:
            warnings.append(
                f"{name}: в файле две колонки «{sp['name']}» — "
                "цепочка не обновлена"
            )
            return
        wanted[sp["name"]] = sp
        if sp.get("agent_profile"):
            sp["_profile_id"] = resolve_profile(
                sp["agent_profile"], lookup, f"{name}/{sp['name']}", result
            )

    to_delete = []
    for st in live:
        if st["name"] in wanted:
            continue
        count = api.call("GET", f"/workflow/steps/{st['id']}/task-count")
        if count.get("task_count", 0) > 0:
            warnings.append(
                f"{name}: колонка «{st['name']}» убрана из файла, но в ней "
                f"{count['task_count']} задач(и) — переместите их, "
                "цепочка не обновлена"
            )
            return
        to_delete.append(st)

    # Сравнение до любой записи: неизменившуюся цепочку не трогаем вовсе.
    id_to_pos = {st["id"]: st["position"] for st in live}
    same_steps = sorted(
        (portable_of_live(st, id_to_pos) for st in live),
        key=lambda p: p["position"],
    ) == sorted(
        (portable_of_file(sp, (live_by_name.get(sp["name"]) or {}).get("agent_profile_id") or "")
         for sp in steps),
        key=lambda p: p["position"],
    )
    same_head = (wf.get("description") or "") == (
        desired.get("description") or ""
    ) and (wf.get("prompt") or "").rstrip("\n") == (desired.get("prompt") or "").rstrip("\n")
    if same_steps and same_head and not to_delete:
        result["unchanged"].append(name)
        return

    # Новые колонки заводим пустыми, чтобы получить идентификаторы: цели
    # переходов могут указывать на них.
    pos_to_id = {}
    for sp in steps:
        st = live_by_name.get(sp["name"])
        if st is None:
            created = api.call(
                "POST",
                "/workflow/steps",
                {
                    "workflow_id": wf["id"],
                    "name": sp["name"],
                    "position": sp["position"],
                    "color": sp.get("color") or "",
                    "allow_manual_move": bool(sp.get("allow_manual_move")),
                },
            )
            st = created.get("step", created)
            live_by_name[sp["name"]] = st
        pos_to_id[sp["position"]] = st["id"]

    for sp in steps:
        st = live_by_name[sp["name"]]
        body = {
            "name": sp["name"],
            "position": sp["position"],
            "events": remap_events(
                sp.get("events"), "step_position", "step_id", pos_to_id.get
            ),
        }
        for f in STEP_FIELDS:
            v = coerce(f, sp.get(f))
            if v is not None:
                body[f] = v
        pull = sp.get("pull_from_step_position")
        if pull is not None:
            body["pull_from_step_id"] = pos_to_id[pull]
        if sp.get("_profile_id"):
            body["agent_profile_id"] = sp["_profile_id"]
        api.call("PUT", f"/workflow/steps/{st['id']}", body)

    for st in to_delete:
        api.call("DELETE", f"/workflow/steps/{st['id']}")

    if not same_head:
        api.call(
            "PATCH",
            f"/workflows/{wf['id']}",
            {
                "description": desired.get("description") or "",
                "prompt": desired.get("prompt") or "",
            },
        )
    result["updated"].append(name)


def ensure_profiles(api, wanted, result):
    """Завести или обновить профили агентов из profiles.yml.

    Агент ищется по внутреннему имени; нет агента — профили пропускаются с
    предупреждением. Возвращает словарь (отображаемое имя агента, модель,
    режим) → id профиля для привязки колонок.
    """
    agents = api.call("GET", "/agents").get("agents", [])
    by_name = {a["name"]: a for a in agents}
    for w in wanted:
        agent = by_name.get(w["agent"])
        if agent is None:
            result["warnings"].append(
                f"профиль «{w['name']}»: агент {w['agent']} не установлен, пропущен"
            )
            continue
        body = {
            "name": w["name"],
            "model": w.get("model") or "",
            "mode": w.get("mode") or "default",
            "auto_approve": bool(w.get("auto_approve", True)),
            "auto_fallback": False,
        }
        # Всегда, даже пустой: иначе снятый в файле параметр (effort у
        # Haiku) остался бы на доске.
        body["config_options"] = {k: str(v) for k, v in (w.get("config_options") or {}).items()}
        have = next((p for p in agent.get("profiles", []) if p["name"] == w["name"]), None)
        if have is None:
            api.call("POST", f"/agents/{agent['id']}/profiles", body, settings=True)
            result.setdefault("profiles_created", []).append(f"{w['agent']}/{w['name']}")
        else:
            same = (
                have.get("model") == body["model"]
                and (have.get("mode") or "default") == body["mode"]
                and bool(have.get("auto_approve")) == body["auto_approve"]
                and (have.get("config_options") or {}) == body.get("config_options", {})
            )
            if not same:
                api.call("PATCH", f"/agent-profiles/{have['id']}", body, settings=True)
                result.setdefault("profiles_updated", []).append(f"{w['agent']}/{w['name']}")
    # Два ключа на профиль: тройка переносимого формата и (агент, имя).
    # Тройка не различает два профиля одной модели с разным усилием
    # (Opus high и Opus xhigh), поэтому колонка может назвать профиль по
    # имени полем `profile_name` рядом с тройкой.
    lookup = {}
    for a in api.call("GET", "/agents").get("agents", []):
        for p in a.get("profiles", []):
            lookup[(p.get("agent_display_name"), p.get("model"), p.get("mode") or "default")] = p["id"]
            lookup[("name", p.get("agent_display_name"), p.get("name"))] = p["id"]
    return lookup


def resolve_profile(spec, lookup, where, result):
    """Тройка из YAML → id профиля; нет такого — предупреждение и None."""
    if not spec:
        return None
    if spec.get("profile_name"):
        key = ("name", spec.get("agent_name"), spec["profile_name"])
    else:
        key = (spec.get("agent_name"), spec.get("model") or "", spec.get("mode") or "default")
    pid = lookup.get(key)
    if pid is None:
        result["warnings"].append(
            f"{where}: профиль {key} на этой машине не найден, колонка оставлена без профиля"
        )
    return pid


def expand_refs(text, prompts, seen=()):
    """Развернуть строки `@имя` в текст роли из prompts/.

    Kandev умеет разворачивать такие ссылки сам, но не на всех путях: после
    `reset_agent_context` и в ходе, который запускает сообщение человека,
    агент получает `@имя` буквально (проверено на живой доске v0.93.0).
    Поэтому в Kandev уезжает уже развёрнутый текст, а ссылки остаются
    только в файлах репозитория, где их удобно читать и проверять.
    """
    out = []
    for line in (text or "").split("\n"):
        name = line.strip()
        if name.startswith("@") and name[1:] in prompts and name[1:] not in seen:
            out.append(expand_refs(prompts[name[1:]], prompts, seen + (name[1:],)))
        else:
            out.append(line)
    return "\n".join(out)


def expand_workflow(desired, prompts):
    desired = dict(desired)
    desired["prompt"] = expand_refs(desired.get("prompt"), prompts).rstrip("\n")
    desired["steps"] = [
        dict(sp, prompt=expand_refs(sp.get("prompt"), prompts).rstrip("\n"))
        for sp in desired.get("steps") or []
    ]
    return desired


def reorder(api, ws, wanted_order, result):
    """Выстроить дорожки на доске по `sort_order` из файлов.

    Цепочки без ключа остаются за перечисленными в своём прежнем порядке.
    Порядок уже такой — вызова нет и в отчёте ничего.
    """
    if not wanted_order:
        return
    live = sorted(
        api.call("GET", f"/workspaces/{ws}/workflows").get("workflows", []),
        key=lambda w: w.get("sort_order") or 0,
    )
    by_name = {w["name"]: w["id"] for w in live}
    first = [by_name[n] for _, n in sorted(wanted_order, key=lambda x: x[0]) if n in by_name]
    rest = [w["id"] for w in live if w["id"] not in first]
    ids = first + rest
    if ids == [w["id"] for w in live]:
        return
    api.call("PUT", f"/workspaces/{ws}/workflows/reorder",
             {"workspace_id": ws, "workflow_ids": ids})
    result["reordered"] = [n for _, n in sorted(wanted_order, key=lambda x: x[0])]


def main():
    payload = json.load(sys.stdin)
    api = Api(payload["api"])
    ws = payload["workspace_id"]
    prompts = payload.get("prompts") or {}
    result = {"created": [], "updated": [], "unchanged": [], "warnings": []}
    lookup = ensure_profiles(api, payload.get("profiles") or [], result)

    existing = api.call("GET", f"/workspaces/{ws}/workflows")
    wanted_order = []
    by_name = {}
    for wf in existing.get("workflows", []):
        by_name.setdefault(wf["name"], wf)

    for f in payload["files"]:
        doc = f["doc"] or {}
        if doc.get("type") != "kandev_workflow" or doc.get("version") != 1:
            result["warnings"].append(
                f"{f['name']}: не переносимый формат Kandev version 1, "
                "пропущен"
            )
            continue
        for desired in doc.get("workflows") or []:
            desired = expand_workflow(desired, prompts)
            if desired.get("sort_order") is not None:
                wanted_order.append((desired.pop("sort_order"), desired["name"]))
            wf = by_name.get(desired["name"])
            if wf is None:
                # Импорт без профилей (Kandev сопоставил бы их сам, но не
                # предупредил бы о несовпадении), затем сверка привязывает
                # профили по нашему словарю.
                bare = dict(desired, agent_profile=None,
                            steps=[{k: v for k, v in sp.items() if k != "agent_profile"}
                                   for sp in desired.get("steps") or []])
                single = dict(doc, workflows=[bare])
                api.call(
                    "POST",
                    f"/workspaces/{ws}/workflows/import",
                    single,
                    content_type="application/x-yaml",
                )
                result["created"].append(desired["name"])
                wf = next((w for w in api.call("GET", f"/workspaces/{ws}/workflows").get("workflows", [])
                           if w["name"] == desired["name"]), None)
                if wf is not None:
                    reconcile(api, wf, desired, result, lookup)
                    if desired["name"] in result["updated"]:
                        result["updated"].remove(desired["name"])
                    if desired["name"] in result["unchanged"]:
                        result["unchanged"].remove(desired["name"])
                continue
            if wf.get("source") not in (None, "", "manual"):
                result["warnings"].append(
                    f"{desired['name']}: цепочка синхронизируется из "
                    f"{wf['source']}, файлом не обновляется"
                )
                continue
            reconcile(api, wf, desired, result, lookup)

    reorder(api, ws, wanted_order, result)

    json.dump(result, sys.stdout, ensure_ascii=False)
    print()


if __name__ == "__main__":
    main()
